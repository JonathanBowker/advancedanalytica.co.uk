---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../lib/seo/site";
import { ibomBenefits } from "../lib/brandoContent";

const title = "IBOM Technology";
const description =
  "IBOM is the Intelligent Business Operations Manager that gives people and AI agents governed access to trusted business data, knowledge, tools, and workflows.";

const page = {
  title,
  description,
  url: `${SITE_URL}/ibom`,
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "IBOM Technology", url: `${SITE_URL}/ibom` },
  ],
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-[#14B8A6]">INTELLIGENT BUSINESS OPERATIONS MANAGER</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          Govern your business data. Give your AI direction.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            IBOM<sup>®</sup> is the Intelligent Business Operations Manager. It is
            Advanced Analytica's technology for bringing approved business data,
            knowledge, policies, tools, and workflows into one governed environment.
          </p>
          <p class="mt-6">
            IBOM gives people and AI agents controlled access to the context and
            capabilities they need. Agent in the Room brings that intelligence
            into a live, expert-led workshop where your business can have a voice.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
            <a href="/how-it-works/" class="aa-outline-cta">HOW IT WORKS</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">What IBOM Gives You</div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {ibomBenefits.map((benefit) => (
          <article class="rounded-2xl border border-ink/10 bg-paper p-7 shadow-outline">
            <div class="eyebrow text-[#14B8A6]">{benefit.label}</div>
            <h2 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
              {benefit.heading}
            </h2>
            <p class="mt-4 text-base leading-relaxed text-steel">
              {benefit.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Next Step</div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Find out what your business data can do.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            A short conversation can identify which data, knowledge, policies,
            and workflows should enter IBOM first.
          </p>
          <p class="mt-6">
            We will help you identify what to map, structure, govern, and test
            before people and agents use that knowledge in live work.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-dark-cta,
    .aa-outline-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.875rem;
      padding: 15px 32px;
      font-weight: 700;
      text-decoration: none;
    }

    .aa-primary-cta,
    .aa-dark-cta {
      border: 1.5px solid #14b8a6;
      background: #14b8a6;
      color: #fff;
    }

    .aa-outline-cta {
      border: 1.5px solid #14b8a6;
      color: #0f766e;
    }
  </style>
</BaseLayout>
