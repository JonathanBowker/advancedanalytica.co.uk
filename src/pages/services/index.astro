---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/seo/site';

const title = 'Services';
const description = 'Data Due Diligence and Agent Skill Building for governed AI operations.';

const page = {
  title,
  description,
  url: `${SITE_URL}/services/`,
  breadcrumbs: [
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Services', url: `${SITE_URL}/services/` }
  ]
};
---
<BaseLayout title={title} description={description} page={page}>
  <section class="container-wide py-16">
    <div class="eyebrow">Services</div>
    <h1 class="mt-4 text-4xl font-semibold text-ink">Our consultancy services</h1>
    <p class="mt-4 text-base text-steel">
      We prepare your business data and build the governed skills and agents that put it to work.
    </p>
  </section>
  <section class="container-wide pb-20">
    <div class="grid gap-6 lg:grid-cols-2">
      <article id="data-due-diligence" class="rounded-xl border border-[#14B8A6]/35 bg-[#f0fbf8] p-6 shadow-outline">
        <div class="text-xs uppercase tracking-[0.2em] text-[#0F766E]">First Step</div>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Data Due Diligence</h2>
        <p class="mt-3 text-sm leading-relaxed text-steel">
          We identify, assess, prepare, and govern the data, knowledge, policies,
          systems, and workflows your people and agents need.
        </p>
      </article>
      <article id="agent-skill-building" class="rounded-xl border border-fog bg-surface p-6">
        <div class="text-xs uppercase tracking-[0.2em] text-steel">Build and Deploy</div>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Agent Skill Building</h2>
        <p class="mt-3 text-sm leading-relaxed text-steel">
          We configure, test, package, and deploy the skills and agents required
          to operate with your approved data, policies, tools, and controls.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
