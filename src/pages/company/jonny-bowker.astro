---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { ORGANIZATION, SITE_URL } from "../../lib/seo/site";

const title = "Jonny Bowker";
const description =
  "Jonny Bowker is the founder of Advanced Analytica, a thought leader, futurist, and pioneer at the frontier of agentic AI who explains complex technology in clear, practical language.";

const page = {
  title,
  description,
  url: `${SITE_URL}/company/jonny-bowker`,
  schemaType: "ProfilePage",
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Company", url: `${SITE_URL}/company/about` },
    { name: "Jonny Bowker", url: `${SITE_URL}/company/jonny-bowker` },
  ],
};

const focusAreas = [
  "Interim AI leadership and accountable direction",
  "AI estate due diligence and opportunity mapping",
  "Agentic AI governance and operating models",
  "Board-level AI strategy, risk, and prioritisation",
  "Controlled workflows, policy, and evidence trails",
  "Production AI implementation in regulated settings",
] as const;
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-center text-[#14B8A6]">Founder Profile</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
            Jonny Bowker
          </h1>
          <p class="mt-6 text-xl font-semibold text-[#0F766E]">
            Founder, Advanced Analytica
          </p>
          <p class="mt-6 max-w-xl border-t border-ink/10 pt-6 font-display text-lg font-semibold leading-relaxed text-ink">
            Jonny Bowker holds the Law Society of Scotland's accreditation for
            intelligent systems expertise. He's built operational and technical
            AI governance inside Fortune 500 enterprises and legal teams.
          </p>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Jonny Bowker is the founder of Advanced Analytica and works at the
            frontier of agentic AI. He helps businesses turn knowledge and
            process into governed agentic systems that can be understood,
            trusted, and used in real business settings.
          </p>
          <p class="mt-6">
            Jonny knows the technology in depth, but his work is grounded in
            clear language, practical judgement, and understanding for the people
            who need AI to be useful. He works spec-first, using text, voice and
            vision AI to build intelligent systems in a way that feels natural
            and tangible.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/company/contact/" class="home-hero__button">
              TALK TO US
            </a>
            <a
              href="/company/interim-ai-directorship/"
              class="inline-flex items-center justify-center rounded-[0.875rem] border-[1.5px] border-[#14B8A6] px-8 py-[15px] font-display text-base font-semibold uppercase text-[#0F766E] transition-colors hover:bg-[#0F766E] hover:text-white"
            >
              INTERIM AI DIRECTORSHIP
            </a>
            <a
              href="https://uk.linkedin.com/in/jonnybowker"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-[0.875rem] border-[1.5px] border-[#14B8A6] px-8 py-[15px] font-display text-base font-semibold uppercase text-[#0F766E] transition-colors hover:bg-[#0F766E] hover:text-white"
            >
              LINKEDIN
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Interim AI Directorship
      </div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Interim AI leadership with responsibility.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            For organisations that need senior AI direction before making a
            permanent hire, Jonny provides interim leadership that starts with
            due diligence, sets priorities, and connects governance to delivery.
          </p>
          <p class="mt-6">
            The work is suited to boards, leadership teams, and transformation
            programmes that need accountable judgement on AI strategy, risk,
            operating models, and production governance.
          </p>
          <div class="mt-8">
            <a
              href="/company/interim-ai-directorship/"
              class="home-hero__button"
            >
              INTERIM AI DIRECTORSHIP
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Areas of Work</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Directing agentic AI systems across business sectors.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Through {ORGANIZATION.name}, Jonny advises, designs, and builds AI
            systems for businesses that need more than a chatbot or a loose
            automation layer. The work starts by making business knowledge
            accessible, then turning it into governed skills, agents, and
            workflows that run in production.
          </p>
          <p class="mt-6">
            That work spans professional services, financial services, private
            equity, investors, healthcare, brand governance, agriculture,
            compliance, and emissions, wherever the need for efficiency exists.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Upskilling Talent</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Upskilling the Next Generation with AI Skills
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Talent does not always land where it should. Plenty of capable
            graduates leave university with real potential and no clear route to
            using it.
          </p>
          <p class="mt-6">
            Jonny mentors young people individually, helping them understand
            where their strengths can create value and directing them towards
            practical AI skills they can apply in a business environment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Upskilling AI</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Upskilling small models to punch above their weight.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Jonny is pioneering a process where a highly capable model is used
            briefly and deliberately to teach a smaller, cheaper model how to
            handle a specific task. The larger model works through the problem
            step by step, and that structured reasoning is transferred into a
            smaller model, adapter, or governed workflow.
          </p>
          <p class="mt-6">
            Once trained, the smaller system can carry more of the reasoning
            itself. Combined with deterministic code around it, this reduces
            dependency on frontier models, lowers running cost and carbon
            impact, and helps turn business knowledge into reusable operational
            IP.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Focus Areas</div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          focusAreas.map((area) => (
            <div class="rounded-2xl border border-ink/10 bg-surface p-6 shadow-outline">
              <p class="text-lg font-semibold tracking-tight text-ink">
                {area}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-semibold tracking-tight text-ink">
          Interim AI direction starts with specification.
        </h2>
        <div
          class="max-w-prose text-lg leading-relaxed text-steel md:text-xl"
        >
          <p>
            AI becomes useful in serious business settings when someone owns
            the intent, boundaries, knowledge, controls, and evidence. That is
            why interim AI leadership starts by specifying what the system
            should do, what it must not do, and who is accountable for the
            decisions it supports.
          </p>
          <div class="mt-8">
            <a
              href="/company/interim-ai-directorship/"
              class="home-hero__button"
            >
              EXPLORE INTERIM AI DIRECTORSHIP
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
