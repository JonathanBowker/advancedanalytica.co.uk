---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { ORGANIZATION, SITE_URL } from "../../lib/seo/site";

const title = "Jonny Bowker";
const description =
  "Jonny Bowker is the founder of Advanced Analytica, a thought leader, futurist, and pioneer at the frontier of agentic AI who explains complex technology in clear, practical language.";

const page = {
  title,
  description,
  url: `${SITE_URL}/company/jonny-bowker`,
  schemaType: "ProfilePage",
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Company", url: `${SITE_URL}/company/about` },
    { name: "Jonny Bowker", url: `${SITE_URL}/company/jonny-bowker` },
  ],
};

const focusAreas = [
  "Agentic AI strategy and architecture",
  "Intelligent Business Operating Models",
  "Spec-driven AI development",
  "AI governance and controlled workflows",
  "Machine-readable policy and MCP architecture",
  "Enterprise AI implementation in regulated settings",
] as const;
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-center text-[#14B8A6]">Founder Profile</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
            Jonny Bowker
          </h1>
          <p class="mt-6 text-xl font-semibold text-[#0F766E]">
            Founder, Advanced Analytica
          </p>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Jonny Bowker is the founder of Advanced Analytica, a thought leader,
            futurist, and pioneer at the frontier of agentic AI. He helps
            businesses turn knowledge and process into controlled agentic AI
            systems that can be understood, trusted, and used in real business
            settings.
          </p>
          <p class="mt-6">
            Jonny knows the technology in depth, but his work is grounded in
            clear language, practical judgement, and empathy for the people who
            need to make AI useful. He focuses on spec-driven development, using
            text, voice and vision AI to help build intelligent systems in a more
            natural and tangible way.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/company/contact/" class="home-hero__button">
              TALK TO US
            </a>
            <a
              href="https://uk.linkedin.com/in/jonnybowker"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-[0.875rem] border-[1.5px] border-[#14B8A6] px-8 py-[15px] font-display text-base font-semibold uppercase text-[#0F766E] transition-colors hover:bg-[#0F766E] hover:text-white"
            >
              LINKEDIN
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Areas of Work</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Building agentic AI systems across all business sectors.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Through {ORGANIZATION.name}, Jonny advises, designs, and builds AI
            systems for businesses that need more than a chatbot or a loose
            automation layer. The work starts by making business knowledge
            accessible, then turning it into governed skills, agents, and
            workflows that run in production.
          </p>
          <p class="mt-6">
            Advanced Analytica works across professional services, financial
            services, private equity, investors, healthcare, brand governance,
            agriculture, compliance, and emissions, wherever the need for
            efficiency exists.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Upskilling People</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Backing the Next Generation with AI Skills
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Talent does not always land where it should. Plenty of capable
            graduates leave university with real potential and no clear route to
            using it.
          </p>
          <p class="mt-6">
            Jonny works with young people individually, not through a programme.
            He gets to know them, then helps them build practical AI skills that
            make them a valuable asset to a business.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Upskilling AI</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Teaching smaller language models to punch above their weight.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Jonny is pioneering a process where a highly capable model teaches a smaller or older, cheaper model how to think. The expensive model is used briefly and deliberately, working through a task step by step, and that reasoning is transferred directly into the cheaper model, like a teacher training a student.
          </p>
          <p class="mt-6">
            Once trained, the cheaper model carries that reasoning itself. Combined with deterministic code built around it, it can punch above its weight, matching the speed and capability of the newest, most expensive models, at a fraction of the running cost and carbon impact, without needing to call the expensive model again.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Focus Areas</div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          focusAreas.map((area) => (
            <div class="rounded-2xl border border-ink/10 bg-surface p-6 shadow-outline">
              <p class="text-lg font-semibold tracking-tight text-ink">
                {area}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-semibold tracking-tight text-paper">
          The operating principle is simple: specify before you automate.
        </h2>
        <div
          class="max-w-prose text-lg leading-relaxed text-paper/78 md:text-xl"
        >
          <p>
            AI becomes useful in serious business settings when it can work from
            clear intent, defined boundaries, current knowledge, and testable
            rules. That is the discipline behind Advanced Analytica’s approach
            to agentic AI and Intelligent Business Operating Models.
          </p>
          <div class="mt-8">
            <a
              href="/opinions/your-ai-is-guessing-here-is-how-to-make-it-know/"
              class="home-hero__button"
            >
              READ THE METHOD
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
