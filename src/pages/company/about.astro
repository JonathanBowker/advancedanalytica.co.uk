---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../lib/seo/site";

const title = "About";
const description =
  "Advanced Analytica is an asset-backed consultancy that prepares business data, builds governed AI agents and gives business intelligence a voice.";

const page = {
  title,
  description,
  url: `${SITE_URL}/company/about`,
  schemaType: "AboutPage",
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Company", url: `${SITE_URL}/company/about` },
    { name: "About", url: `${SITE_URL}/company/about` },
  ],
};

const beliefs = [
  {
    num: "01",
    heading: "Data governance is an operating problem.",
    body: "The hard part is not choosing a model. It is making business data usable, governed and trusted inside the workflows where AI acts.",
  },
  {
    num: "02",
    heading: "Documents do not enforce themselves.",
    body: "Guidelines, policies and standards only matter when systems can read, apply and test them, then record what happened.",
  },
  {
    num: "03",
    heading: "Speed needs evidence.",
    body: "AI can accelerate delivery, but responsible businesses need clear specifications, acceptance criteria, evidence and accountable decisions.",
  },
  {
    num: "04",
    heading: "The client should own the asset.",
    body: "IBOM is delivered as governed technology, not a rented platform or a black box that traps the client's business data.",
  },
] as const;

const operatingLoop = [
  {
    label: "Discover",
    heading: "Find the real operating context",
    body: "AI helps us map policies, workflows, assets, and edge cases quickly, so expert review starts from evidence rather than a blank page.",
  },
  {
    label: "Specify",
    heading: "Turn judgement into requirements",
    body: "We convert fuzzy intent into structured rules, acceptance criteria, examples, and tests that both people and systems can work from.",
  },
  {
    label: "Validate",
    heading: "Challenge before we build",
    body: "Assisted review surfaces gaps, contradictions, risks, and dependencies before they become delivery problems.",
  },
  {
    label: "Deliver",
    heading: "Move from plan to production",
    body: "AI accelerates the build loop, while human judgement controls quality, governance, client decisions, and sign-off.",
  },
] as const;
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-center text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          Bring your data to life. Give your business a voice.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Advanced Analytica is an asset-backed consultancy. We prepare
            business data, build governed AI agents and connect both through
            technology our clients can own.
          </p>
          <p class="mt-6">
            <a href="/company/jonny-bowker/" class="font-semibold text-[#0F766E] underline decoration-[#14B8A6]/30 underline-offset-4 hover:text-ink">Jonny Bowker</a>
            founded the firm to close the gap between using AI and trusting it
            with real work. That gap is where data, governance and delivery
            must come together.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
            <a href="/how-it-works/" class="aa-outline-cta">OUR METHODOLOGY</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Why we exist</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          To close one gap.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Buying AI is easy. Giving it reliable data, clear authority and
            controlled access to business systems is harder.
          </p>
          <p class="mt-6">
            Agentic Due Diligence establishes what is ready and what must
            change. Governed Agent Operations then builds, deploys and monitors
            each agent. IBOM connects the approved sources.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Our story</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          A lesson from years of data, governance, and delivery work.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Advanced Analytica comes from the practical side of business
            change: data management, governance, operational control and better
            decisions with complex information.
          </p>
          <p class="mt-6">
            The pattern is familiar. Businesses invest in technology while its
            knowledge remains trapped in documents, people, exceptions and
            informal review loops. AI makes that gap impossible to ignore.
          </p>
          <p class="mt-6">
            We turn that knowledge into structured data, governed technology
            and working agents. The client retains control of the resulting
            assets.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">What we believe</div>
      <h2 class="mx-auto max-w-4xl text-center text-5xl font-extrabold tracking-tight text-ink">
        Four convictions the firm is built on.
      </h2>
      <div class="mx-auto mt-14 max-w-5xl divide-y divide-ink/12">
        {beliefs.map((belief) => (
          <article class="grid gap-6 py-8 md:grid-cols-[0.18fr_0.82fr] md:items-start">
            <div class="eyebrow text-[#14B8A6]">{belief.num}</div>
            <div>
            <h3 class="text-3xl font-semibold tracking-tight text-ink">
              {belief.heading}
            </h3>
            <p class="mt-4 max-w-[74ch] text-lg leading-relaxed text-steel">
              {belief.body}
            </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">AI-native delivery</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-semibold tracking-tight text-paper">
            We use AI to make the work sharper, not looser.
          </h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-paper/78 md:text-xl">
            We use AI throughout our own work, from discovery to assurance. The
            standard is never “the model said so”. The work must be traceable,
            challengeable and governed by a named owner.
          </p>
        </div>
        <div class="divide-y divide-paper/14 border-y border-paper/14">
          {operatingLoop.map((step) => (
            <article class="grid gap-4 py-6 md:grid-cols-[0.24fr_0.76fr] md:items-start">
              <div class="eyebrow text-[#14B8A6]">{step.label}</div>
              <div>
                <h3 class="text-2xl font-semibold tracking-tight text-paper">
                  {step.heading}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-paper/72">
                  {step.body}
                </p>
              </div>
            </article>
          ))}
          <div class="py-7">
            <p class="max-w-[64ch] text-2xl font-semibold leading-snug tracking-tight text-paper">
              Not automation for its own sake. A faster, clearer route to
              evidence-backed work: specifications that make sense, decisions
              that are visible, and delivery that remains accountable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Where we are going</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          To make governed AI useful in real business work.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            We are building from the UK for businesses that need AI to be
            useful, governed and defensible. Our focus is the difficult work
            between ambition and accountable operation.
          </p>
          <p class="mt-6">
            Data, policy, process and expert judgement all shape business
            decisions. IBOM keeps that context attached so people and agents
            can use it responsibly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Ready when you are</div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Let’s talk about your agenda.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            The first conversation identifies the work that matters, the data
            behind it and the controls required before an agent acts.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-outline-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.875rem;
      padding: 15px 32px;
      font-weight: 700;
      text-decoration: none;
    }

    .aa-primary-cta {
      border: 1.5px solid #14b8a6;
      background: #14b8a6;
      color: #fff;
    }

    .aa-outline-cta {
      border: 1.5px solid #14b8a6;
      color: #0f766e;
    }
  </style>
</BaseLayout>
