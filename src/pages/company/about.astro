---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../lib/seo/site";

const title = "About";
const description =
  "Advanced Analytica helps organisations turn brand knowledge, policy, and expert judgement into governed AI-ready operating assets.";

const page = {
  title,
  description,
  url: `${SITE_URL}/company/about`,
  schemaType: "AboutPage",
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Company", url: `${SITE_URL}/company/about` },
    { name: "About", url: `${SITE_URL}/company/about` },
  ],
};

const beliefs = [
  {
    num: "01",
    heading: "AI governance is an operating problem.",
    body: "The hard part is not choosing a model. It is making organisational knowledge usable, governed, and trusted inside the workflows where AI acts.",
  },
  {
    num: "02",
    heading: "Documents do not enforce themselves.",
    body: "Guidelines, policies, and standards only matter if systems can read them, apply them, test against them, and record what happened.",
  },
  {
    num: "03",
    heading: "Speed needs evidence.",
    body: "AI can accelerate delivery, but serious organisations need specifications, acceptance criteria, audit trails, and accountable decisions.",
  },
  {
    num: "04",
    heading: "The client should own the asset.",
    body: "Brando is delivered as a governed operating asset, not a rented content platform or a black box that traps the organisation.",
  },
] as const;

const operatingLoop = [
  {
    label: "Discover",
    heading: "Find the real operating context",
    body: "AI helps us map policies, workflows, assets, and edge cases quickly, so expert review starts from evidence rather than a blank page.",
  },
  {
    label: "Specify",
    heading: "Turn judgement into requirements",
    body: "We convert fuzzy intent into structured rules, acceptance criteria, examples, and tests that both people and systems can work from.",
  },
  {
    label: "Validate",
    heading: "Challenge before we build",
    body: "Assisted review surfaces gaps, contradictions, risks, and dependencies before they become delivery problems.",
  },
  {
    label: "Deliver",
    heading: "Move from plan to production",
    body: "AI accelerates the build loop, while human judgement controls quality, governance, client decisions, and sign-off.",
  },
] as const;
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-center text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          You have the knowledge. Now make AI operate it.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Advanced Analytica helps organisations turn brand standards,
            policies, business rules, and expert judgement into governed
            AI-ready operating assets.
          </p>
          <p class="mt-6">
            We built the firm for the gap between “we are using AI” and “AI is
            working safely inside the business.” That page is where most
            programmes stall. It is also where the value is.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/company/contact/" class="aa-primary-cta">Book a Conversation</a>
            <a href="/ibom-way/" class="aa-outline-cta">See the IBOM Way</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f0e8] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Why We Exist</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          To close one gap.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            The distance between “we have AI tools” and “we can trust AI in
            production” is where brand, legal, risk, technology, and operations
            start pulling in different directions.
          </p>
          <p class="mt-6">
            We close that gap by making knowledge operational. Brando turns the
            rules, examples, approvals, and judgement behind a brand into a
            governed asset AI systems can read and follow. IBOM is the framework
            that gets it scoped, defined, checked, built, and adopted.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Our Story</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          A lesson from years of data, governance, and delivery work.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Advanced Analytica comes from the practical side of enterprise
            change: data management, governance, operational control, and the
            hard work of helping teams make better decisions with complex
            information.
          </p>
          <p class="mt-6">
            The pattern is familiar. Organisations invest in technology, but the
            knowledge it depends on remains trapped in documents, people,
            exceptions, and informal review loops. AI makes that gap impossible
            to ignore.
          </p>
          <p class="mt-6">
            That is why we focus on structured knowledge, governed delivery, and
            assets the client can own. The technology matters. The operating
            model matters more.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f0e8] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">What We Believe</div>
      <h2 class="mx-auto max-w-4xl text-center text-5xl font-extrabold tracking-tight text-ink">
        Four convictions the firm is built on.
      </h2>
      <div class="mx-auto mt-14 max-w-5xl divide-y divide-ink/12">
        {beliefs.map((belief) => (
          <article class="grid gap-6 py-8 md:grid-cols-[0.18fr_0.82fr] md:items-start">
            <div class="eyebrow text-[#14B8A6]">{belief.num}</div>
            <div>
            <h3 class="text-3xl font-semibold tracking-tight text-ink">
              {belief.heading}
            </h3>
            <p class="mt-4 max-w-[74ch] text-lg leading-relaxed text-steel">
              {belief.body}
            </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">AI-Native Delivery</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-semibold tracking-tight text-paper">
            We use AI to make the work sharper, not looser.
          </h2>
          <p class="mt-6 max-w-prose text-lg leading-relaxed text-paper/78 md:text-xl">
            We do not sell a future we are unwilling to use ourselves. Our own
            delivery is AI-assisted from discovery to assurance, but the
            standard is never “the model said so.” The standard is whether the
            work can be checked, challenged, governed, and stood behind.
          </p>
        </div>
        <div class="divide-y divide-paper/14 border-y border-paper/14">
          {operatingLoop.map((step) => (
            <article class="grid gap-4 py-6 md:grid-cols-[0.24fr_0.76fr] md:items-start">
              <div class="eyebrow text-[#14B8A6]">{step.label}</div>
              <div>
                <h3 class="text-2xl font-semibold tracking-tight text-paper">
                  {step.heading}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-paper/72">
                  {step.body}
                </p>
              </div>
            </article>
          ))}
          <div class="py-7">
            <p class="max-w-[64ch] text-2xl font-semibold leading-snug tracking-tight text-paper">
              Not automation for its own sake. A faster, clearer route to
              evidence-backed work: specifications that make sense, decisions
              that are visible, and delivery that remains accountable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f0e8] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Where We Are Going</div>
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          To define what excellent AI brand operation looks like.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            We are building from the UK for organisations that need AI adoption
            to be useful, governed, and defensible. The ambition is not to be a
            generic AI consultancy. It is to set the standard for turning brand
            and business knowledge into operational assets.
          </p>
          <p class="mt-6">
            Brando starts with brand because brand is where trust becomes
            visible. The same IBOM logic extends into policy, service,
            compliance, operations, and any business domain where AI needs to
            act from trusted knowledge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Ready When You Are</div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <h2 class="text-5xl font-extrabold tracking-tight text-ink">
          Let’s talk about your agenda.
        </h2>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            The first conversation maps where AI already touches your knowledge,
            which workflows carry the most risk, and what needs to be governed
            before you put agents into production.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="aa-primary-cta">Book a Conversation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-outline-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.875rem;
      padding: 15px 32px;
      font-weight: 700;
      text-decoration: none;
    }

    .aa-primary-cta {
      border: 1.5px solid #14b8a6;
      background: #14b8a6;
      color: #fff;
    }

    .aa-outline-cta {
      border: 1.5px solid #14b8a6;
      color: #0f766e;
    }
  </style>
</BaseLayout>
