---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../lib/seo/site';

const title = 'Page not found';
const description = 'The page you requested could not be found.';
const page = {
  title,
  description,
  url: `${SITE_URL}/404/`,
  noindex: true,
  breadcrumbs: [
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Page not found', url: `${SITE_URL}/404/` }
  ]
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="not-found bg-[#eef2f5] text-ink">
    <div class="not-found__grid" aria-hidden="true"></div>
    <div class="container-wide not-found__inner">
      <div class="not-found__copy">
        <div class="eyebrow text-[#14B8A6]">404 · Page Not Found</div>
        <h1>This page has lost its place in the system.</h1>
        <p>
          The link may have changed, or the page may no longer exist. Start
          again with our technology, services or site search.
        </p>
        <div class="not-found__actions">
          <a href="/" class="home-hero__button">Back to home</a>
          <a href="/search/" class="not-found__outline">Search the site</a>
        </div>
      </div>

      <div class="not-found__visual" aria-hidden="true">
        <span class="not-found__orbit not-found__orbit--outer"></span>
        <span class="not-found__orbit not-found__orbit--inner"></span>
        <span class="not-found__node not-found__node--one"></span>
        <span class="not-found__node not-found__node--two"></span>
        <span class="not-found__node not-found__node--three"></span>
        <div class="not-found__code">404</div>
        <div class="not-found__status">Source not found</div>
      </div>
    </div>

    <div class="container-wide not-found__routes">
      <a href="/#ibom">
        <span>Technology</span>
        <strong>Explore IBOM®</strong>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/services/">
        <span>Consultancy</span>
        <strong>Explore our services</strong>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/case-studies/">
        <span>Evidence</span>
        <strong>View case studies</strong>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    .not-found {
      position: relative;
      isolation: isolate;
      min-height: calc(100svh - 5rem);
      overflow: hidden;
    }

    .not-found__grid {
      position: absolute;
      inset: 0;
      z-index: -2;
      opacity: .38;
      background-image: radial-gradient(circle, rgba(15,118,110,.22) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: linear-gradient(to bottom, black, transparent 78%);
    }

    .not-found::after {
      content: '';
      position: absolute;
      z-index: -1;
      width: 38rem;
      height: 38rem;
      right: -16rem;
      top: -14rem;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(20,184,166,.2), transparent 68%);
    }

    .not-found__inner {
      display: grid;
      align-items: center;
      gap: 4rem;
      padding-block: clamp(5rem, 10vw, 9rem);
    }

    .not-found__copy h1 {
      max-width: 12ch;
      margin-top: 1.4rem;
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6.8rem);
      font-weight: 900;
      letter-spacing: -.045em;
      line-height: .98;
    }

    .not-found__copy p {
      max-width: 42rem;
      margin-top: 1.8rem;
      color: var(--color-steel);
      font-size: clamp(1.1rem, 1.7vw, 1.35rem);
      line-height: 1.6;
    }

    .not-found__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2.2rem;
    }

    .not-found__outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 15px 32px;
      border: 1.5px solid #14b8a6;
      border-radius: .875rem;
      color: #0f766e;
      font-family: var(--font-display);
      font-weight: 700;
      text-decoration: none;
      transition: background 180ms ease, color 180ms ease, transform 180ms ease;
    }

    .not-found__outline:hover {
      background: #14b8a6;
      color: #fff;
      transform: translateY(-1px);
    }

    .not-found__visual {
      position: relative;
      display: grid;
      width: min(31rem, 86vw);
      aspect-ratio: 1;
      place-items: center;
      justify-self: center;
      border: 1px solid rgba(11,18,32,.12);
      border-radius: 2rem;
      background: #0b1220;
      box-shadow: 0 30px 75px rgba(15,23,42,.18);
      color: #f3f0e8;
    }

    .not-found__visual::before {
      content: '';
      position: absolute;
      inset: 1.5rem;
      border-radius: 1.35rem;
      opacity: .22;
      background-image: radial-gradient(circle, #5eead4 1px, transparent 1px);
      background-size: 19px 19px;
    }

    .not-found__code {
      position: relative;
      font-family: var(--font-display);
      font-size: clamp(5rem, 15vw, 9rem);
      font-weight: 900;
      letter-spacing: -.08em;
      line-height: 1;
    }

    .not-found__status {
      position: absolute;
      bottom: 3.4rem;
      color: #5eead4;
      font-size: .72rem;
      font-weight: 800;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .not-found__orbit {
      position: absolute;
      border: 1px solid rgba(94,234,212,.23);
      border-radius: 999px;
    }
    .not-found__orbit--outer { width: 72%; height: 72%; animation: not-found-spin 18s linear infinite; }
    .not-found__orbit--inner { width: 49%; height: 49%; animation: not-found-spin 12s linear infinite reverse; }
    .not-found__node { position: absolute; width: .65rem; height: .65rem; border-radius: 999px; background: #14b8a6; box-shadow: 0 0 20px rgba(20,184,166,.7); }
    .not-found__node--one { top: 13.5%; left: 48%; }
    .not-found__node--two { right: 23%; bottom: 25%; }
    .not-found__node--three { left: 25%; bottom: 24%; }

    .not-found__routes {
      display: grid;
      gap: 1px;
      padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .not-found__routes a {
      display: grid;
      grid-template-columns: 7rem 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: 1.3rem 1.4rem;
      border-top: 1px solid rgba(11,18,32,.12);
      color: var(--color-ink);
      text-decoration: none;
      transition: background 180ms ease, padding-inline 180ms ease;
    }

    .not-found__routes a:last-child { border-bottom: 1px solid rgba(11,18,32,.12); }
    .not-found__routes a:hover { padding-inline: 1.8rem; background: rgba(20,184,166,.08); }
    .not-found__routes a > span:first-child { color: #0f766e; font-size: .68rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .not-found__routes strong { font-family: var(--font-display); font-size: 1.08rem; }
    .not-found__routes a > span:last-child { color: #14b8a6; font-size: 1.25rem; }

    @keyframes not-found-spin { to { transform: rotate(360deg); } }

    @media (min-width: 960px) {
      .not-found__inner { grid-template-columns: minmax(0, 1.05fr) minmax(24rem, .7fr); }
    }

    @media (max-width: 520px) {
      .not-found__routes a { grid-template-columns: 1fr auto; }
      .not-found__routes a > span:first-child { grid-column: 1 / -1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .not-found__orbit { animation: none; }
      .not-found__outline, .not-found__routes a { transition: none; }
    }
  </style>
</BaseLayout>
