---
import BaseLayout from "../layouts/BaseLayout.astro";
import IbomTabbedVisual from "../components/IbomTabbedVisual.astro";
import { SITE_URL } from "../lib/seo/site";
import { howItWorksCards } from "../lib/brandoContent";

const title = "How IBOM Works";
const description =
  "See how Advanced Analytica prepares business data, connects it through IBOM® and puts governed AI agents into controlled work.";

const page = {
  title,
  description,
  url: `${SITE_URL}/how-it-works`,
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "How IBOM Works", url: `${SITE_URL}/how-it-works` },
  ],
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          From business need to governed operation.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            AI cannot use knowledge that remains scattered across systems,
            documents and people. IBOM brings approved sources into one
            governed intelligence layer.
          </p>
          <p class="mt-6">
            We map the work, prepare the data and define what each agent may
            see, decide and change. Every action has a clear control and
            escalation route.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Control Layer</div>
      <h2
        class="mx-auto max-w-4xl text-center text-5xl font-semibold tracking-tight text-paper"
      >
        One layer connects everything your agents need to act.
      </h2>
      <p
        class="mx-auto mt-8 max-w-[82ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
      >
        IBOM connects people, policies, knowledge, workflows, data and AI. Each
        action follows approved business context instead of relying on a prompt.
      </p>
      <div class="mx-auto mt-10 max-w-6xl">
        <IbomTabbedVisual />
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">The Process</div>
      <h2
        class="mx-auto mb-12 max-w-3xl text-center text-5xl font-semibold tracking-tight text-ink"
      >
        Three stages from knowledge to governed operation.
      </h2>
      <div class="grid gap-6 lg:grid-cols-3">
        {
          howItWorksCards.map((item) => (
            <article class="rounded-2xl border border-ink/10 bg-paper p-7 shadow-outline">
              <h2 class="text-2xl font-semibold tracking-tight text-ink">
                {item.heading}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-steel">
                {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Scenario Testing
      </div>
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Test each agent before it touches live work.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Customers ask questions. Regulators expect precision. Teams make
            decisions and systems trigger actions. We test those moments before
            any agent enters live work.
          </p>
          <p class="mt-6">
            The tests show where knowledge, rules and controls hold, and where
            ambiguity remains. Each scenario must meet an agreed threshold
            before release.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Put It To Work</div>
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Start with one workflow. Prove it works. Then scale.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            We identify one business workflow where an agent can create
            measurable value. That could involve operations, approvals,
            analysis, service or internal decisions.
          </p>
          <p class="mt-6">
            We map the workflow, connect approved data and define its rules and
            controls. You see it working in context before wider deployment.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-dark-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #14b8a6;
      border-radius: 0.875rem;
      background: #14b8a6;
      padding: 15px 32px;
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</BaseLayout>
