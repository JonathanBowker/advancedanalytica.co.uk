---
import BaseLayout from "../layouts/BaseLayout.astro";
import AiceGatewayCluster from "../components/AiceGatewayCluster.astro";
import { SITE_URL } from "../lib/seo/site";
import { howItWorksCards } from "../lib/brandoContent";

const title = "How IBOM Works";
const description =
  "See how Advanced Analytica identifies high-value Agentic AI opportunities, models business knowledge and controls through IBOM, and deploys governed AI agents into production.";

const page = {
  title,
  description,
  url: `${SITE_URL}/how-it-works`,
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "How IBOM Works", url: `${SITE_URL}/how-it-works` },
  ],
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          From opportunity to intelligent operations.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Most businesses cannot scale what they cannot codify. We move your
            business processes, expert judgement, and operating rules into a
            governed intelligence layer your AI can use and share.
          </p>
          <p class="mt-6">
            The work starts with mapping and ends with controlled workflows,
            review paths, escalation rules, and audit visibility.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="aa-primary-cta">Talk to Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Control Layer</div>
      <h2
        class="mx-auto max-w-4xl text-center text-5xl font-semibold tracking-tight text-paper"
      >
        How controlled AI becomes operational excellence
      </h2>
      <p
        class="mx-auto mt-8 max-w-[82ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
      >
        The control layer connects people, policies, knowledge, operating rules,
        workflows, data assets, and AI agents so every action is shaped by your
        business context.
      </p>
      <div class="mx-auto mt-10 max-w-6xl">
        <AiceGatewayCluster />
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="grid gap-6 lg:grid-cols-3">
        {
          howItWorksCards.map((item) => (
            <article class="rounded-2xl border border-ink/10 bg-paper p-7 shadow-outline">
              <h2 class="text-2xl font-semibold tracking-tight text-ink">
                {item.heading}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-steel">
                {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Role-Intent Testing
      </div>
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            We show you where Agentic AI creates value and risk.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Customers ask for answers. Regulators expect precision. Teams make
            decisions. Systems trigger actions. AI agents summarise, analyse,
            recommend, approve, escalate, and respond.
          </p>
          <p class="mt-6">
            We build role-intent scenarios around those moments, then test where
            your knowledge, rules, workflows, and controls hold, where ambiguity
            appears, and what needs to be strengthened before agents go live.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="aa-primary-cta">Talk to Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Put It To Work</div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Find the workflows where agentic AI can create the most value.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            The implementation starts by choosing a live business workflow where
            Agentic AI can create measurable value: operations, service,
            approvals, analysis, content, or internal decision support.
          </p>
          <p class="mt-6">
            We help you map the workflow, connect the knowledge and data assets,
            define the rules and controls, and determine what must be true
            before the agent can operate safely and effectively.
          </p>
          <div class="mt-8">
                 <a href="/company/contact/" class="aa-primary-cta">Talk to Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-dark-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #14b8a6;
      border-radius: 0.875rem;
      background: #14b8a6;
      padding: 15px 32px;
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</BaseLayout>
