---
import BaseLayout from "../layouts/BaseLayout.astro";
import AiceGatewayCluster from "../components/AiceGatewayCluster.astro";
import { SITE_URL } from "../lib/seo/site";
import { howItWorksCards } from "../lib/brandoContent";

const title = "How IBOM Works";
const description =
  "See how Advanced Analytica identifies high-value agentic AI opportunities, models business knowledge and controls through IBOM, and deploys governed AI agents into production.";

const page = {
  title,
  description,
  url: `${SITE_URL}/how-it-works`,
  breadcrumbs: [
    { name: "Home", url: `${SITE_URL}/` },
    { name: "How IBOM Works", url: `${SITE_URL}/how-it-works` },
  ],
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <div class="mt-8 grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <h1 class="text-6xl font-black leading-none tracking-tight text-ink">
          From opportunity to intelligent operations.
        </h1>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Most businesses cannot scale what they cannot codify. IBOM moves
            your business processes, expert judgement and operating rules into a
            governed intelligence layer your AI agents can consume, follow and
            act on.
          </p>
          <p class="mt-6">
            The work starts with mapping what your business actually knows and
            ends with controlled workflows, defined escalation paths and full
            audit visibility across every agent action.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="aa-primary-cta">Talk to Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Control Layer</div>
      <h2
        class="mx-auto max-w-4xl text-center text-5xl font-semibold tracking-tight text-paper"
      >
        One layer connects everything your agents need to act.
      </h2>
      <p
        class="mx-auto mt-8 max-w-[82ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
      >
        The control layer connects your people, policies, knowledge, operating
        rules, workflows, data assets and AI agents so every action is shaped by
        your business context, not inferred from a prompt.
      </p>
      <div class="mx-auto mt-10 max-w-6xl">
        <AiceGatewayCluster />
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">The Process</div>
      <h2
        class="mx-auto mb-12 max-w-3xl text-center text-5xl font-semibold tracking-tight text-ink"
      >
        Three stages from knowledge to governed operation.
      </h2>
      <div class="grid gap-6 lg:grid-cols-3">
        {
          howItWorksCards.map((item) => (
            <article class="rounded-2xl border border-ink/10 bg-paper p-7 shadow-outline">
              <h2 class="text-2xl font-semibold tracking-tight text-ink">
                {item.heading}
              </h2>
              <p class="mt-4 text-base leading-relaxed text-steel">
                {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Scenario Testing
      </div>
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            We test your agents before they go anywhere near production.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Customers ask questions. Regulators expect precision. Teams make
            decisions. Systems trigger actions. Before any agent goes live, we
            build role-intent scenarios around those moments and test them.
          </p>
          <p class="mt-6">
            We find where your knowledge, rules and controls hold, and where
            ambiguity appears. Each scenario is scored against a defined pass
            threshold, and nothing goes to production until every scenario
            clears it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Put It To Work</div>
      <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Start with one workflow. Prove it works. Then scale.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            We identify a live business workflow where agentic AI can create
            immediate, measurable value, whether that is operations, approvals,
            analysis, service or internal decision support.
          </p>
          <p class="mt-6">
            We map the workflow, connect the knowledge and data assets, define
            the rules and controls, and build it out. You see it working on your
            own operations before you commit to full deployment.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="aa-primary-cta">Talk to Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .aa-primary-cta,
    .aa-dark-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #14b8a6;
      border-radius: 0.875rem;
      background: #14b8a6;
      padding: 15px 32px;
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
</BaseLayout>
