---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../lib/seo/site';

const title = 'Enterprise';
const description = 'Governed AI systems for businesses working across teams, markets and regulatory boundaries.';

const useCases = (await getCollection('case-studies', ({ data }) => !data.draft)).filter(
  (entry) => Boolean(entry.data.industry || entry.data.outcomes?.length)
);

const page = {
  title,
  description,
  url: `${SITE_URL}/enterprise`,
  breadcrumbs: [
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Enterprise', url: `${SITE_URL}/enterprise` }
  ]
};
---
<BaseLayout title={title} description={description} page={page}>
  <section class="container-wide py-16">
    <div class="eyebrow">Enterprise</div>
    <h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-ink">One governed intelligence layer across a complex business</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-steel">
      Advanced Analytica prepares approved business data and builds the agents that use it.
      IBOM keeps ownership, permissions and controls attached across teams, markets and systems.
    </p>
  </section>

  <section class="container-wide pb-20">
    <div class="grid gap-6 lg:grid-cols-3">
      {useCases.map((useCase) => (
        <article class="rounded-xl border border-fog bg-surface p-6">
          <div class="text-xs uppercase tracking-[0.2em] text-steel">{useCase.data.industry}</div>
          <h2 class="mt-3 text-xl font-semibold text-ink">{useCase.data.title}</h2>
          <p class="mt-3 text-sm text-steel">{useCase.data.description}</p>
          {useCase.data.outcomes && (
            <ul class="mt-4 list-disc pl-5 text-xs text-steel">
              {useCase.data.outcomes.map((outcome) => (
                <li>{outcome}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
