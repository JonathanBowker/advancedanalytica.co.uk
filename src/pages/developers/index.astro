---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/seo/site';

const title = 'Developers';
const description = 'Technical entry points for connecting approved business data, policies and agents through IBOM®.';

const page = {
  title,
  description,
  url: `${SITE_URL}/developers`,
  breadcrumbs: [
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Developers', url: `${SITE_URL}/developers` }
  ]
};
---
<BaseLayout title={title} description={description} page={page}>
  <section class="container-wide py-16">
    <div class="eyebrow">Developers</div>
    <h1 class="mt-4 text-4xl font-semibold text-ink">Build on governed business intelligence</h1>
    <p class="mt-4 text-base text-steel">
      IBOM<sup>®</sup> connects approved business data, policies and controls to the agents and workflows that need them.
    </p>

    <h2 class="mt-12 text-2xl font-semibold tracking-tight text-ink">
      Give agents controlled access to:
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        {
          title: 'Apply policy',
          body: 'Apply approved business rules inside workflows and AI tooling.'
        },
        {
          title: 'Stay versioned',
          body: 'Keep changes, approvals and exceptions visible over time.'
        },
        {
          title: 'Explain decisions',
          body: 'Return the evidence needed to understand and review outcomes.'
        },
        {
          title: 'Measure drift',
          body: 'Identify material changes and route them through controlled review.'
        }
      ].map((item) => (
        <div class="rounded-2xl border border-fog bg-surface p-6 shadow-outline">
          <div class="text-xs font-semibold tracking-[0.2em] uppercase text-steel">{item.title}</div>
          <p class="mt-3 text-sm leading-relaxed text-steel">{item.body}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="container-wide pb-20">
    <div class="grid gap-6 lg:grid-cols-2">
      <a href="/developers/quickstart" class="rounded-xl border border-fog bg-surface p-6">
        <div class="text-sm font-semibold text-ink">Quickstart</div>
        <p class="mt-3 text-sm text-steel">Connect one approved workflow to IBOM and test its controls.</p>
      </a>
      <a href="/developers/mcp-servers" class="rounded-xl border border-fog bg-surface p-6">
        <div class="text-sm font-semibold text-ink">MCP Servers</div>
        <p class="mt-3 text-sm text-steel">Serve approved business context to agents through controlled interfaces.</p>
      </a>
    </div>
  </section>
</BaseLayout>
