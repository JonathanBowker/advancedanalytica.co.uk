---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AiceGatewayCluster from "../components/AiceGatewayCluster.astro";
import { getCollection } from "astro:content";
import { SITE_URL } from "../lib/seo/site";

const title = "Agentic AI for UK Enterprises | Advanced Analytica";
const description =
  "Advanced Analytica gets Agentic AI into production for UK enterprises. Using IBOM®, we identify high-value opportunities, prove value in weeks, and deploy governed AI agents and skills that scale.";

const latestPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const page = {
  title,
  description,
  url: `${SITE_URL}/`,
  breadcrumbs: [{ name: "Home", url: `${SITE_URL}/` }],
};

const latestCaseStudies = (
  await getCollection("case-studies", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const pathways = [
  {
    eyebrow: "First Step",
    title: "AI Knowledge Packs",
    body: "Prepare scattered documents, policies, process knowledge, and expert judgement as structured data assets that AI systems can use reliably.",
    href: "/services/ai-ready-knowledge-packs/",
  },
  {
    eyebrow: "Framework",
    title: "IBOM",
    body: "See the Intelligent Business Operating Model that turns business knowledge, rules, workflows, skills, and controls into governed Agentic AI.",
    href: "/ibom/",
  },
  {
    eyebrow: "Delivery",
    title: "How It Works",
    body: "See how we move from opportunity identification through mapping, modelling, validation, deployment, and controlled operation.",
    href: "/how-it-works/",
  },
  {
    eyebrow: "Example Agent",
    title: "Brando",
    body: "See how the same governed approach can turn brand knowledge, standards, and judgement into a production-ready AI Brand Operator.",
    href: "/brando/",
  },
  {
    eyebrow: "Leadership",
    title: "For Leaders",
    body: "Understand the value, governance, operating model, and control implications of deploying Agentic AI across the enterprise.",
    href: "/for-leaders/",
  },
] as const;
---

<BaseLayout title={title} description={description} page={page}>
  <section class="home-hero bg-paper text-ink">
    <div class="container-wide home-hero__inner">
      <div class="eyebrow mb-10 text-left font-bold">MOVE FAST. STAY SAFE.</div>
      <div class="home-split-grid home-split-grid--hero">
        <h1 class="home-hero__title">
          You've adopted AI. <br />Now make it deliver.
        </h1>
        <div>
          <p class="home-hero__lead">
            As your independent partner, with no ties to any software, data or
            AI provider, we support the full life cycle of agentic AI system
            development, and apply it wherever your business runs on repeatable
            processes, knowledge, judgement and rules, across every function,
            team and market you operate in.
          </p>
          <div class="home-hero__actions">
            <a href="#agentic-consultancy" class="mt-6 home-hero__secondary">
              <span>OUR CONSULTANCY</span>
              <span aria-hidden="true">↓</span>
            </a>

            <a href="#agentic-technology" class="mt-6 home-hero__secondary">
              <span>OUR TECHNOLOGY</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="chatbot-vs-agentic-ai" class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Chatbot Or Agentic AI
      </div>
      <div class="home-split-grid">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            What is the difference between a chatbot and agentic AI?
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            A chatbot supports a dialogue, the human stays in the loop, interprets the response, and decides what happens next. Agentic AI is different: give it information, rules, tools, and a defined objective, and it completes the task itself, inside agreed boundaries, without needing a human to carry the process.
          </p>
          <div class="mt-8">
            <a href="#why" class="home-outline-cta">WHAT IS AGENTIC AI?</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="why" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center">What is Agentic AI</div>
      <div class="home-split-grid">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            What is Agentic AI and why does it matter?
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Agentic AI systems plan, decide and act across multiple steps to
            reach a defined goal, working within the boundaries you set. Unlike
            generative AI, which simply responds to a prompt with text or an
            image, an agentic system can use tools, call APIs, and take real
            action inside your operational workflows.
          </p>
          <div class="mt-8">
            <a href="#how" class="home-hero__secondary">
              <span>HOW AGENTIC AI HELPS</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        How Agentic AI Helps
      </div>
      <div class="home-split-grid">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            How does agentic AI help your business?
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            Agentic AI is an efficiency accelerator. It turns your knowledge,
            policies and judgement into structured data that agents can consume
            and act on, giving them defined rules to follow rather than leaving
            them to infer how your business operates. A governed operating
            capability, built on your knowledge and your rules.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#our-services" class="home-outline-cta">OUR SERVICES</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="our-services" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Our Services</div>
      <div class="grid gap-12 md:grid-cols-2 lg:gap-18">
        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Agentic System Design
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We work with senior teams to define what an agentic system needs to
            do, how it should be governed, and what a buildable specification
            looks like. Strategy stays grounded in what can actually be built
            and tested before anything is committed.
          </p>
          <a href="#agentic-consultancy" class="mt-6 home-hero__secondary">
            <span>OUR CONSULTANCY</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Agentic System Tooling
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We build agentic systems that take a defined input, reason through
            it against structured rules, and return a governed decision or
            action. Every system ships with the specification, validation logic,
            and audit trail built in from the start.
          </p>
          <a href="#agentic-technology" class="mt-6 home-hero__secondary">
            <span>OUR TECHNOLOGY</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="agentic-consultancy" class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Our Consultancy
      </div>
      <div class="grid gap-12 lg:grid-cols-3">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            Business needs
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We use our IBOM<sup>®</sup> methodology to identify where agentic AI creates
            the greatest business value, then define the agents and skills you need.
          </p>
        </div>

        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            Proof of value
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We take one real workflow and build it out using our technology, so
            you see agentic AI working on your own operations before you commit.
          </p>
        </div>

        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            System delivery
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We design, deploy and operate your agentic system across every
            layer, managing trade-offs with you as it moves into production and
            scales.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
      </div>
    </div>
  </section>

  <section id="agentic-technology" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Our Technology</div>

      <p
        class="mt-6 mb-6 text-center text-lg leading-relaxed text-steel md:text-xl"
      >
        Our agentic system management supports two key operating models.
      </p>

      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Single agent operation
          </h2>

          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            Autonomous agents that own and execute one clearly defined business
            workflow end to end.
          </p>

          <p class="mt-6">
            A single AI agent understands its environment, makes decisions, uses
            tools and takes action to achieve a defined goal, without constant
            human prompting, creating focused, repeatable value across a bounded
            operation.
          </p>
        </div>

        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Multi-agent operation
          </h2>

          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            Connected agents that collaborate across complex workflows no single
            agent can manage alone.
          </p>

          <p class="mt-6">
            A multi-agent system coordinates specialised agents, skills, data
            and actions across multiple tasks to achieve broader goals, driving
            value through faster sales cycles, cost reduction, customer service
            and automated operations.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
      </div>
    </div>
  </section>

  <section id="ibom" class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">
        IBOM<sup>®</sup> - Intelligent Business Operating Model
      </div>
      <h2
        class="mx-auto max-w-4xl text-center text-5xl font-semibold tracking-tight text-paper"
      >
        One controlled layer between your workforce, your workflows, your
        systems, and your AI.
      </h2>
      <p
        class="mx-auto mt-8 max-w-[82ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
      >
        IBOM connects people, agents, workflows, knowledge, systems, policies,
        and controls through one centralised control layer.
      </p>
      <div
        id="ibom-visual"
        class="relative mx-auto mt-10 w-full max-w-6xl scroll-mt-28"
        aria-label="Business operations delivered through IBOM visualisation"
      >
        <AiceGatewayCluster />
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/how-it-works/" class="home-dark-outline-cta">
          SEE HOW IT WORKS
        </a>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Case Studies</div>
      <h2 class="text-center text-5xl font-extrabold tracking-tight text-ink">
        Problems solved, not logos displayed.
      </h2>
      <p
        class="mx-auto mt-5 max-w-[76ch] text-center text-lg leading-relaxed text-steel md:text-xl"
      >
        We work with challenger businesses and Fortune 500 brands to advise on,
        design, and build agentic AI systems for complex operating
        environments. Much of that work sits behind confidentiality, so we focus
        on the problems solved.
      </p>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {
          latestCaseStudies
            .slice(0, 3)
            .map((caseStudy) => (
              <PostCard
                post={caseStudy}
                basePath="/case-studies"
                showTags={false}
              />
            ))
        }
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <a href="/case-studies/" class="home-outline-cta">CASE STUDIES</a>
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Latest Thinking</div>
      <h2 class="text-center text-5xl font-extrabold tracking-tight text-ink">
        Latest Posts
      </h2>
      <p
        class="mx-auto mt-5 max-w-[70ch] text-center text-lg leading-relaxed text-steel md:text-xl"
      >
        Recent thinking on Agentic AI, governed business operations, and
        knowledge-first deployment.
      </p>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {latestPosts.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <a href="/opinions/" class="home-outline-cta">MORE THINKING</a>
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Start The Conversation
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Find out where to create the greatest value.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            The useful first step is not another deck. It is a clear view of
            where Agentic AI can improve performance, which workflows carry the
            greatest opportunity and risk, and what needs to change before
            agents go into production.
          </p>
          <p class="mt-6">
            We turn that into a practical route from opportunity to governed
            Agentic AI in production.
          </p>
          <div class="mt-8">
            <a href="/company/contact/" class="home-hero__button">
              TALK TO US
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .home-split-grid {
      display: grid;

      gap: 2.5rem;
    }

    .home-hero {
      border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, white);
    }

    .home-hero__inner {
      padding-top: 7rem;

      padding-bottom: 5rem;
    }

    .home-hero__title {
      max-width: 13.1ch;

      margin: 0;

      font-family: var(--font-display);

      font-size: clamp(38px, 4.5vw, 62px);

      font-weight: 1000;

      letter-spacing: -0.016em;

      line-height: 1.12;

      color: var(--color-ink);

      -webkit-text-stroke: 0.3px var(--color-ink);

      text-wrap: balance;
    }

    .home-hero__lead {
      max-width: 34rem;

      margin: 0 0 2rem;

      font-family: var(--font-body);

      font-size: 1.125rem;

      font-weight: 400;

      line-height: 1.625;

      color: color-mix(in srgb, var(--color-ink) 62%, white);

      text-wrap: pretty;
    }

    .home-hero__actions {
      display: flex;

      align-items: center;

      gap: 2rem;

      flex-wrap: wrap;
    }

    .home-hero__button,
    .home-dark-cta {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 15px 32px;

      border: 1.5px solid #14b8a6;

      border-radius: 0.875rem;

      background: #14b8a6;

      color: #fff;

      font-family: var(--font-display);

      font-size: 1rem;

      font-weight: 600;

      text-decoration: none;

      white-space: nowrap;

      transition:
        background 180ms ease,
        border-color 180ms ease,
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .home-hero__button:hover,
    .home-dark-cta:hover {
      background: #0f766e;

      border-color: #0f766e;

      transform: translateY(-1px);

      box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.1),
        0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .home-hero__secondary,
    .home-outline-cta,
    .home-dark-outline-cta {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 0.7rem;

      padding: 15px 32px;

      border: 1.5px solid #14b8a6;

      border-radius: 0.875rem;

      background: transparent;

      font-family: var(--font-display);

      font-size: 1rem;

      font-weight: 600;

      color: #0f766e;

      text-decoration: none;

      white-space: nowrap;

      transition:
        color 180ms ease,
        border-color 180ms ease,
        background-color 180ms ease,
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .home-dark-outline-cta {
      color: #5eead4;
    }

    .home-hero__secondary:hover,
    .home-outline-cta:hover,
    .home-dark-outline-cta:hover {
      color: #ffffff;

      background: #14b8a6;

      border-color: #14b8a6;

      transform: translateY(-1px);

      box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.1),
        0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    .home-inline-cta {
      display: inline-flex;

      align-items: center;

      gap: 0.45rem;

      font-weight: 700;

      color: #0f766e;

      text-decoration: none;
    }

    .home-inline-cta:hover {
      color: #14b8a6;
    }

    .home-ask-ai-actions {
      display: none;

      flex-wrap: nowrap;

      gap: 0.75rem;

      margin-top: 1rem;
    }

    .home-ask-ai-button {
      display: inline-flex;

      min-height: 44px;

      min-width: 132px;

      align-items: center;

      justify-content: center;

      padding: 0 18px;

      border: 1.5px solid var(--color-ink);

      border-radius: 0.5rem;

      background: var(--color-ink);

      color: #ffffff;

      font-family: var(--font-display);

      font-size: 0.95rem;

      font-weight: 600;

      text-decoration: none;

      white-space: nowrap;

      transition:
        color 180ms ease,
        background-color 180ms ease,
        transform 180ms ease;
    }

    .home-ask-ai-button:hover,
    .home-ask-ai-button:focus-visible {
      background: transparent;

      color: var(--color-ink);

      transform: translateY(-1px);
    }

    .aa-ai-overlay {
      position: fixed;

      inset: 0;

      z-index: 80;

      display: grid;

      place-items: center;

      padding: 1.25rem;

      background: rgba(11, 18, 32, 0.58);

      opacity: 0;

      transition: opacity 220ms ease;

      pointer-events: none;
    }

    .aa-ai-overlay.is-visible {
      opacity: 1;

      pointer-events: auto;
    }

    .aa-ai-dialog {
      width: min(27rem, 100%);

      padding: 1.25rem 1.35rem;

      border: 1px solid rgba(255, 255, 255, 0.14);

      border-radius: 0.5rem;

      background: rgba(11, 18, 32, 0.96);

      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.24);

      color: #ffffff;

      font-family: var(--font-display);

      transform: translateY(0.5rem) scale(0.98);

      transition:
        opacity 220ms ease,
        transform 220ms ease;
    }

    .aa-ai-overlay.is-visible .aa-ai-dialog {
      transform: translateY(0);
    }

    .aa-ai-dialog__eyebrow {
      margin-bottom: 0.35rem;

      color: #14b8a6;

      font-size: 0.76rem;

      font-weight: 700;

      letter-spacing: 0.14em;

      text-transform: uppercase;
    }

    .aa-ai-dialog__message {
      margin: 0;

      font-size: 1.05rem;

      font-weight: 700;

      line-height: 1.4;
    }

    @media (max-width: 960px) {
      .home-hero__inner {
        padding-top: 6.5rem;

        padding-bottom: 4rem;
      }

      .home-hero__title {
        max-width: 12ch;
      }

      h2 {
        font-size: 2.65rem;

        line-height: 1.08;
      }
    }

    @media (min-width: 1024px) {
      .home-split-grid {
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);

        gap: 4.5rem;

        align-items: start;
      }

      .home-split-grid--hero {
        gap: 5rem;
      }
    }
  </style>

  <script is:inline>
    const ensureSalesFunnelOverlayStyles = () => {
      if (document.querySelector("[data-sales-funnel-overlay-style]")) return;

      const style = document.createElement("style");

      style.setAttribute("data-sales-funnel-overlay-style", "");

      style.textContent = `

        .aa-ai-overlay {

          position: fixed;

          inset: 0;

          z-index: 2147483000;

          display: grid;

          place-items: center;

          padding: 1.25rem;

          background: rgba(11, 18, 32, 0.68);

          opacity: 0;

          transition: opacity 220ms ease;

          pointer-events: none;

        }

        .aa-ai-overlay.is-visible {

          opacity: 1;

          pointer-events: auto;

        }

        .aa-ai-dialog {

          width: min(27rem, 100%);

          padding: 1.25rem 1.35rem;

          border: 1px solid rgba(255, 255, 255, 0.14);

          border-radius: 0.5rem;

          background: rgba(11, 18, 32, 0.96);

          box-shadow: 0 18px 45px rgba(0, 0, 0, 0.24);

          color: #ffffff;

          font-family: var(--font-display);

          transform: translateY(0.5rem) scale(0.98);

          transition:

            opacity 220ms ease,

            transform 220ms ease;

        }

        .aa-ai-overlay.is-visible .aa-ai-dialog {

          transform: translateY(0);

        }

        .aa-ai-dialog__eyebrow {

          margin-bottom: 0.35rem;

          color: #14b8a6;

          font-size: 0.76rem;

          font-weight: 700;

          letter-spacing: 0.14em;

          text-transform: uppercase;

        }

        .aa-ai-dialog__message {

          margin: 0;

          font-size: 1.05rem;

          font-weight: 700;

          line-height: 1.4;

        }

        .aa-ai-spinner {

          display: block;

          width: 14.25rem;

          height: 14.25rem;

          margin: 1.5rem auto 0;

          overflow: visible;

        }

        .aa-ai-spinner__core,

        .aa-ai-spinner__dot-orbit {

          transform-box: view-box;

          transform-origin: 73.92px 80px;

          animation: aa-ai-spinner-ring 2.25s linear infinite;

        }

        .aa-ai-spinner__core,

        .aa-ai-spinner__dot {

          fill: #ffffff;

        }

        .aa-ai-spinner__dot {

          transform-box: view-box;

          transform-origin: 45.54px 32.67px;

          animation: aa-ai-spinner-dot 2.25s linear infinite;

        }

        @keyframes aa-ai-spinner-ring {

          0%,

          28% {

            transform: rotate(0deg);

          }

          72%,

          100% {

            transform: rotate(-360deg);

          }

        }

        @keyframes aa-ai-spinner-dot {

          0%,

          14% {

            opacity: 1;

            transform: translate(0, 0);

          }

          28%,

          72% {

            opacity: 1;

            transform: translate(0, 36px);

          }

          86%,

          100% {

            opacity: 1;

            transform: translate(0, 0);

          }

        }

      `;

      document.head.appendChild(style);
    };

    const showSalesFunnelOverlay = (message) => {
      ensureSalesFunnelOverlayStyles();

      let overlay = document.querySelector("[data-sales-funnel-overlay]");

      if (!(overlay instanceof HTMLElement)) {
        overlay = document.createElement("div");

        overlay.className = "aa-ai-overlay";

        overlay.setAttribute("data-sales-funnel-overlay", "");

        overlay.innerHTML =
          '<div class="aa-ai-dialog" role="status" aria-live="polite"><div class="aa-ai-dialog__eyebrow">AI source</div><p class="aa-ai-dialog__message" data-sales-funnel-message></p><svg class="aa-ai-spinner" viewBox="0 0 147.84 147.84" aria-hidden="true" focusable="false"><g class="aa-ai-spinner__core"><path d="M93.08,107.24c.66,5.88-3.94,10.88-9.69,10.88-3.62,0-6.77-1.98-8.45-4.91-.44-.77-1.58-.77-2.02,0-1.68,2.93-4.84,4.91-8.45,4.91-5.75,0-10.36-5-9.69-10.88.5-4.46,4.1-8.06,8.56-8.57,4.08-.46,7.72,1.6,9.58,4.83.45.79,1.58.79,2.04,0,1.86-3.22,5.51-5.29,9.58-4.83,4.46.51,8.06,4.11,8.56,8.57Z"/><path d="M64.46,61.35c3.62,0,6.77-1.98,8.45-4.91.44-.77,1.58-.77,2.02,0,1.68,2.93,4.84,4.91,8.45,4.91,5.75,0,10.36-5,9.69-10.88-.5-4.46-4.1-8.06-8.56-8.57-4.07-.46-7.72,1.6-9.58,4.83-.45.79-1.58.79-2.04,0-1.86-3.22-5.51-5.29-9.58-4.83-4.46.51-8.06,4.11-8.56,8.57-.66,5.88,3.94,10.88,9.69,10.88Z"/><path d="M50.4,81c-.79-.45-.79-1.58,0-2.04,3.22-1.86,5.29-5.51,4.83-9.58-.51-4.46-4.11-8.06-8.57-8.56-5.88-.66-10.88,3.94-10.88,9.69,0,3.62,1.98,6.77,4.91,8.45.77.44.77,1.58,0,2.02-2.93,1.68-4.91,4.84-4.91,8.45,0,5.75,5,10.36,10.88,9.69,4.46-.5,8.06-4.1,8.57-8.56.46-4.08-1.6-7.72-4.83-9.58Z"/><path d="M107.18,81c-.79-.45-.79-1.58,0-2.04,3.22-1.86,5.29-5.51,4.83-9.58-.51-4.46-4.11-8.06-8.57-8.56-5.88-.66-10.88,3.94-10.88,9.69,0,3.62,1.98,6.77,4.91,8.45.77.44.77,1.58,0,2.02-2.93,1.68-4.91,4.84-4.91,8.45,0,5.75,5,10.36,10.88,9.69,4.46-.5,8.06-4.1,8.57-8.56.46-4.08-1.6-7.72-4.83-9.58Z"/></g><g class="aa-ai-spinner__dot-orbit"><circle class="aa-ai-spinner__dot" cx="45.54" cy="32.67" r="9.76"/></g></svg></div>';

        document.body.appendChild(overlay);
      }

      const messageNode = overlay.querySelector("[data-sales-funnel-message]");

      if (messageNode) messageNode.textContent = message;

      requestAnimationFrame(() => {
        overlay.classList.add("is-visible");
      });

      return overlay;
    };

    const setSalesFunnelOverlayMessage = (overlay, message) => {
      const messageNode = overlay.querySelector("[data-sales-funnel-message]");

      if (messageNode) messageNode.textContent = message;
    };

    const navigateWithOverlay = (overlay, url) => {
      overlay.classList.add("is-visible");

      window.setTimeout(() => {
        window.location.href = url;
      }, 120);
    };

    document.addEventListener("click", async (event) => {
      const target =
        event.target instanceof Element
          ? event.target.closest("[data-sales-funnel-assistant]")
          : null;

      if (!(target instanceof HTMLAnchorElement)) return;

      if (target.getAttribute("aria-busy") === "true") return;

      event.preventDefault();

      const fallbackUrl = target.href;

      const overlay = showSalesFunnelOverlay(
        "Preparing the AI-readable source...",
      );

      target.setAttribute("aria-busy", "true");

      try {
        const response = await fetch("/api/sales-funnel/page-build", {
          method: "POST",

          headers: { "Content-Type": "application/json" },

          credentials: "same-origin",

          body: JSON.stringify({
            assistant: target.dataset.salesFunnelAssistant || "unknown",

            sourceUrl: window.location.href,
          }),
        });

        const payload = await response.json();

        const outboundUrl =
          response.ok && payload && typeof payload.assistant_url === "string"
            ? payload.assistant_url
            : fallbackUrl;

        setSalesFunnelOverlayMessage(overlay, "Opening your assistant...");

        navigateWithOverlay(overlay, outboundUrl);
      } catch {
        setSalesFunnelOverlayMessage(overlay, "Opening your assistant...");

        navigateWithOverlay(overlay, fallbackUrl);
      }
    });
  </script>
</BaseLayout>
