---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import IbomTabbedVisual from "../components/IbomTabbedVisual.astro";
import AgentBriefDropdown from "../components/AgentBriefDropdown.astro";
import { getCollection } from "astro:content";
import { SITE_URL } from "../lib/seo/site";

const title = "Agentic AI for UK Enterprises | Advanced Analytica";
const description =
  "Advanced Analytica gets Agentic AI into production for UK enterprises. Using IBOM®, we identify high-value opportunities, prove value in weeks, and deploy governed AI agents and skills that scale.";

const latestPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const page = {
  title,
  description,
  url: `${SITE_URL}/`,
  breadcrumbs: [{ name: "Home", url: `${SITE_URL}/` }],
};

const latestCaseStudies = (
  await getCollection("case-studies", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

---

<BaseLayout title={title} description={description} page={page}>
  <section class="home-hero text-ink">
    <video
      class="home-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-porcelain-firefly.jpg"
      aria-hidden="true"
    >
      <source
        src="/videos/hero-porcelain-firefly.mp4"
        type="video/mp4"
      />
    </video>
    <div class="container-wide home-hero__inner">
      <div class="home-hero__content">
        <h1 class="home-hero__title">
          <span class="home-hero__title-line">Bring your data to life.</span>
          <span class="home-hero__title-line">Give your business a voice.</span>
        </h1>
        <a
          class="home-hero__arrow"
          href="#home-introduction"
          aria-label="Continue to the introduction"
        >
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section id="home-introduction" class="home-intro scroll-mt-20 bg-[#eef2f5] text-ink">
    <div class="container-wide home-intro__inner">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">MOVE FAST. STAY SAFE.</div>
      <p class="home-intro__copy">
        As an independent partner, with no ties to any software, data or AI
        provider, we advise, design and engineer AI systems around the way
        your business actually works. We turn its processes, knowledge,
        judgement and rules into governed data operations that can scale across
        functions, teams and markets.
      </p>
      <p class="home-intro__statement">
        Build AI that works from trusted business knowledge and stays within
        the boundaries set by you.
      </p>
      <div class="home-hero__actions">
        <a href="#ibom" class="home-hero__secondary">
          <span>OUR TECHNOLOGY</span>
          <span aria-hidden="true">↓</span>
        </a>

        <a href="#our-services" class="home-hero__secondary">
          <span>OUR CONSULTANCY</span>
          <span aria-hidden="true">↓</span>
        </a>
        <AgentBriefDropdown label="USE YOUR AGENT" />
      </div>
    </div>
  </section>

  <section id="ibom" class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">
        Our Technology — IBOM
      </div>
      <h2
        class="mx-auto max-w-4xl text-center text-3xl font-semibold tracking-tight text-paper sm:text-4xl md:text-5xl"
      >
        One controlled layer between your workforce, your data, and your AI.
      </h2>
      <p
        class="mx-auto mt-6 max-w-[82ch] text-center text-base leading-relaxed text-paper/80 sm:mt-8 sm:text-lg md:text-xl"
      >
        IBOM<sup>®</sup> gives AI controlled access to specialist, proprietary and web data,
        enabling multi-step research and agent execution with cited, structured
        outputs across business functions and R&amp;D.
      </p>
      <div
        id="ibom-visual"
        class="relative mx-auto mt-10 w-full max-w-6xl scroll-mt-28"
        aria-label="Business operations delivered through IBOM visualisation"
      >
        <IbomTabbedVisual />
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/how-it-works/" class="home-dark-outline-cta">
          SEE HOW IT WORKS
        </a>
      </div>
    </div>
  </section>

  <section id="agent-in-the-room" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Our Technology — Agent in the Room<sup class="align-super text-[0.55em] font-normal">®</sup>
      </div>
      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <h2 class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl">
            Give your business, your data and your AI a voice.
          </h2>
          <div class="mt-6 max-w-prose space-y-6 text-lg leading-relaxed text-steel md:text-xl">
            <p>
              We build AI agents grounded in your data, shaped by your knowledge
              and focused on the challenges that matter most to your business —
              agents your people can talk to naturally, as well as use through
              chat.
            </p>
            <p>
              Then we bring those agents into the room alongside your people
              and our experts. Together, they challenge assumptions, explore
              possibilities and shape a practical way forward — always within
              your rules.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/company/contact/"
              class="home-hero__button"
            >
              TALK TO US
            </a>
            <AgentBriefDropdown label="TALK TO AI" action="menu" variant="primary" />
          </div>
        </div>
        <a
          href="https://actai.studio/#air"
          target="_blank"
          rel="noreferrer"
          class="group relative block overflow-hidden rounded-3xl bg-black"
          aria-label="Explore Agent in the Room on Act AI Studio"
        >
          <video
            src="https://actai.studio/videos/air-texture.mp4"
            poster="https://actai.studio/images/air-texture-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            class="aspect-video h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          ></video>
          <svg
            class="pointer-events-none absolute inset-0 h-full w-full"
            viewBox="0 0 800 450"
            aria-hidden="true"
          >
            <path
              d="M 192 154 C 152 190, 152 260, 192 296"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <path
              d="M 152 114 C 92 168, 92 282, 152 336"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <path
              d="M 112 74 C 28 148, 28 302, 112 376"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <path
              d="M 608 154 C 648 190, 648 260, 608 296"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <path
              d="M 648 114 C 708 168, 708 282, 648 336"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <path
              d="M 688 74 C 772 148, 772 302, 688 376"
              fill="none"
              stroke="white"
              stroke-width="16"
            />
            <text
              x="400"
              y="225"
              fill="white"
              text-anchor="middle"
              dominant-baseline="central"
              font-family="Arial, Helvetica, sans-serif"
              font-size="218"
              font-weight="700"
              letter-spacing="-8"
            >AIR</text>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section id="how" class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Agentic AI, Grounded In Your Data
      </div>
      <div class="home-split-grid">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Turn business data into knowledge AI can use.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            AI is only as useful as the information it can access. We collect
            and structure the knowledge, policies, processes and judgement your
            business relies on, then add ownership, permissions and controls.
            The result is trusted, machine-readable data that agents can use
            reliably.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#our-services" class="home-outline-cta">OUR SERVICES</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="our-services" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">Our Consultancy</div>
      <div class="grid gap-12 md:grid-cols-2 lg:gap-x-18 lg:gap-y-16">
        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Data Due Diligence
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            We identify the data, knowledge, policies and systems your business
            already relies on, then assess how each source is collected,
            structured and governed. Each source is added to a clear inventory
            and matched to a dedicated agent specification, ready for
            development.
          </p>
          <a href="#agentic-consultancy" class="mt-6 home-hero__secondary">
            <span>OUR CONSULTANCY</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div>
          <h2
            class="text-4xl font-extrabold tracking-tight text-ink md:text-5xl"
          >
            Agent Skill Building
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-steel md:text-xl">
            The Agent Skill Bench provides proven capabilities to collect and
            transform data, retrieve knowledge, operate workflows, apply rules
            and assure quality. We configure the skills each agent needs,
            connect them to your systems and test them before they enter live
            operations.
          </p>
          <a href="#ibom" class="mt-6 home-hero__secondary">
            <span>OUR TECHNOLOGY</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="agentic-consultancy" class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Our Methodology
      </div>
      <div class="methodology-carousel" data-methodology-carousel>
        <div class="methodology-track" data-methodology-track>
        <div class="methodology-card">
          <div class="methodology-step">Step 1</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            Business Understanding
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            We begin by defining goals, decisions, workflows, people and
            constraints that determine where governed AI can create measurable
            business value.
          </p>
        </div>

        <div class="methodology-card">
          <div class="methodology-step">Step 2</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            Data Understanding
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            With priorities clear, we map the data, knowledge, policies and
            systems each workflow depends on, identifying ownership, quality
            and gaps.
          </p>
        </div>

        <div class="methodology-card">
          <div class="methodology-step">Step 3</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            Data Preparation
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            We then collect, clean, structure and govern those sources,
            attaching permissions, provenance and controls so agents can use
            them reliably.
          </p>
        </div>

        <div class="methodology-card">
          <div class="methodology-step">Step 4</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            IBOM Modeling
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            Using the prepared sources, we model the agents, skills, workflows,
            tools and controls needed to deliver reliable, governed business
            operations.
          </p>
        </div>

        <div class="methodology-card">
          <div class="methodology-step">Step 5</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            IBOM Evaluation
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            Before release, we test each output, decision and action against
            agreed measures for performance, quality, safety and governance in
            operation.
          </p>
        </div>

        <div class="methodology-card">
          <div class="methodology-step">Step 6</div>
          <h2 class="text-3xl font-extrabold tracking-tight text-ink">
            IBOM Deployment
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-steel">
            Once validated, we deploy agents into live workflows, monitor their
            performance and improve them as business needs and knowledge evolve.
          </p>
        </div>
        </div>

        <div class="methodology-controls" aria-label="Methodology carousel controls">
          <button type="button" data-methodology-previous aria-label="Show previous methodology stage">←</button>
          <button type="button" data-methodology-next aria-label="Show next methodology stage">→</button>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
        <AgentBriefDropdown label="TALK TO AI" action="menu" variant="primary" />
      </div>
    </div>
  </section>

  <section class="bg-[#eef2f5] text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Case Studies</div>
      <h2 class="text-center text-5xl font-extrabold tracking-tight text-ink">
        Problems solved, not logos displayed.
      </h2>
      <p
        class="mx-auto mt-5 max-w-[76ch] text-center text-lg leading-relaxed text-steel md:text-xl"
      >
        We work with challenger businesses and Fortune 500 brands to advise on,
        design, and build agentic AI systems for complex operating
        environments. Much of that work sits behind confidentiality, so we focus
        on the problems solved.
      </p>
      <div class="mt-12 grid items-stretch gap-8 lg:grid-cols-3">
        {
          latestCaseStudies
            .slice(0, 3)
            .map((caseStudy) => (
              <PostCard
                post={caseStudy}
                basePath="/case-studies"
                showTags={false}
                showDate
              />
            ))
        }
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <a href="/case-studies/" class="home-outline-cta">CASE STUDIES</a>
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
        <AgentBriefDropdown label="TALK TO AI" action="menu" variant="primary" />
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center text-[#14B8A6]">Latest Thinking</div>
      <h2 class="text-center text-5xl font-extrabold tracking-tight text-ink">
        Latest Posts
      </h2>
      <p
        class="mx-auto mt-5 max-w-[70ch] text-center text-lg leading-relaxed text-steel md:text-xl"
      >
        Recent thinking on Agentic AI, governed business operations, and
        knowledge-first deployment.
      </p>
      <div class="mt-12 grid items-stretch gap-8 lg:grid-cols-3">
        {latestPosts.slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <a href="/opinions/" class="home-outline-cta">MORE THINKING</a>
        <a href="/company/contact/" class="home-hero__button">TALK TO US</a>
        <AgentBriefDropdown label="TALK TO AI" action="menu" variant="primary" />
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center text-[#14B8A6]">
        Start The Conversation
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight text-ink">
            Find out where to create the greatest value.
          </h2>
        </div>
        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
            We find where the value is, identify the data behind it, and bring
            that data into IBOM.
          </p>
          <p class="mt-6">
            Then we give your business a voice that your people and AI can use.
          </p>
          <p class="mt-8 font-bold text-ink">
            Talk to us. We'll talk to your AI.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            <AgentBriefDropdown label="Talk to our AI" action="menu" variant="primary" />
            <span class="text-steel/70">or</span>
            <a href="/company/contact/" class="home-hero__button">
              TALK TO A PERSON
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .methodology-carousel {
      min-width: 0;
    }

    .methodology-track {
      display: flex;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 1.5rem;
      overflow-x: auto;
      padding: 0.25rem 0.1rem 1.25rem;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
    }

    .methodology-track::-webkit-scrollbar {
      display: none;
    }

    .methodology-card {
      position: relative;
      flex: 0 0 calc((100% - 3rem) / 3);
      min-height: 15rem;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-ink) 11%, transparent);
      border-radius: 0.9rem;
      background: var(--color-paper);
      padding: clamp(1.5rem, 2.5vw, 2rem);
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
      scroll-snap-align: start;
      transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    }

    .methodology-controls {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .methodology-controls button {
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border: 1px solid rgba(20, 184, 166, 0.55);
      border-radius: 999px;
      background: transparent;
      color: #0f766e;
      font-size: 1.15rem;
      transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
    }

    .methodology-controls button:hover,
    .methodology-controls button:focus-visible {
      border-color: #14b8a6;
      background: #14b8a6;
      color: #f3f0e8;
      outline: none;
    }

    .methodology-card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 3px;
      background: #14b8a6;
    }

    .methodology-step {
      margin-bottom: 0.85rem;
      color: #0f766e;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .methodology-card:hover {
      border-color: rgba(20, 184, 166, 0.45);
      transform: translateY(-3px);
      box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
      .methodology-track {
        scroll-behavior: auto;
      }

      .methodology-card {
        transition: none;
      }

      .methodology-card:hover {
        transform: none;
      }
    }

    @media (max-width: 1023px) {
      .methodology-card {
        flex-basis: calc((100% - 1.5rem) / 2);
      }
    }

    @media (max-width: 639px) {
      .methodology-card {
        flex-basis: 100%;
      }
    }

    .home-split-grid {
      display: grid;

      gap: 2.5rem;
    }

    .home-hero {
      position: relative;

      isolation: isolate;

      overflow: hidden;

      height: calc(100svh - 5rem);

      min-height: 44rem;

      max-height: 85.375rem;

      background: #eef2f5;

      border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, white);
    }

    .home-hero__video {
      position: absolute;

      inset: 0;

      width: 100%;

      height: 143%;
    }

    .home-hero__video {
      z-index: 0;

      object-fit: cover;

      object-position: center 35%;
    }

    .home-hero__inner {
      position: relative;

      z-index: 2;

      display: grid;

      height: 100%;

      place-items: center;

      padding-top: 4rem;

      padding-bottom: 4rem;
    }

    .home-hero__content {
      position: relative;

      display: grid;

      width: min(70rem, 100%);

      justify-items: center;

      margin-inline: auto;

      text-align: center;
    }

    .home-hero__title {
      width: 100%;

      max-width: 66rem;

      margin: 0 auto;

      font-family: "Plus Jakarta Sans", var(--font-display);

      font-size: clamp(2.75rem, 5vw, 5.5rem);

      font-weight: 800;

      letter-spacing: -0.015em;

      line-height: 1.1;

      color: #ffffff;

      text-wrap: balance;
    }

    .home-hero__title-line {
      display: block;

      text-align: center;

      white-space: nowrap;
    }

    .home-hero__arrow {
      position: absolute;

      top: 100%;

      left: 50%;

      display: inline-grid;

      width: 3.5rem;

      height: 3.5rem;

      margin-top: clamp(1.75rem, 4vh, 3.5rem);

      transform: translateX(-50%);

      place-items: center;

      border: 1.5px solid rgba(255, 255, 255, 0.9);

      border-radius: 999px;

      color: #ffffff;

      font-size: 1.65rem;

      line-height: 1;

      text-decoration: none;

      transition:
        color 180ms ease,
        background-color 180ms ease,
        transform 180ms ease;
    }

    .home-hero__arrow:hover {
      background: #ffffff;

      color: #0f766e;

      transform: translate(-50%, 3px);
    }

    .home-intro__inner {
      display: grid;

      justify-items: center;

      padding-top: 5rem;

      padding-bottom: clamp(4rem, 8vw, 7rem);

      text-align: center;
    }

    .home-intro__copy {
      max-width: 52rem;

      margin: 0 auto;

      font-size: clamp(1.125rem, 1.6vw, 1.4rem);

      line-height: 1.6;

      color: var(--color-steel);

      text-wrap: pretty;
    }

    .home-intro__statement {
      max-width: 48rem;

      margin: 1rem auto 0;

      font-size: clamp(1.125rem, 1.6vw, 1.4rem);

      font-weight: 800;

      line-height: 1.5;

      text-wrap: balance;
    }

    .home-hero__actions {
      display: flex;

      align-items: center;

      justify-content: center;

      gap: 1rem;

      flex-wrap: wrap;

      margin-top: clamp(1.5rem, 3vh, 2.5rem);
    }

    .home-hero__button,
    .home-dark-cta {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 15px 32px;

      border: 1.5px solid #14b8a6;

      border-radius: 0.875rem;

      background: #14b8a6;

      color: #fff;

      font-family: var(--font-display);

      font-size: 1rem;

      font-weight: 600;

      text-decoration: none;

      white-space: nowrap;

      transition:
