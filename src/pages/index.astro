---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import AiceGatewayCluster from "../components/AiceGatewayCluster.astro";
import { getCollection } from "astro:content";
import { SITE_URL } from "../lib/seo/site";
import { businessFunctions } from "../lib/businessFunctions";
import usesPurposeUnderstandingImg from "../components/uses/assessment.svg?url";
import usesSystemFramingImg from "../components/uses/frame.svg?url";
import usesSpecificationDesignImg from "../components/uses/codification.svg?url";
import usesValidationEvaluationImg from "../components/uses/evaluation.svg?url";
import usesExecutionGenerationImg from "../components/uses/operation.svg?url";

const title = "Brand-First AI Governance";
const description =
  "Make your brand AI-ready. Brando turns brand standards, business logic, and expert judgement into a Brand Brain AI agents can follow.";

const usesTabs = [
  {
    key: "platform_asset_pack_architecture",
    label: "1. Architect",
    stage: "Stage 1",
    phase: "Phase 1",
    heading: "ARCHITECT",
    subheading: "Design the blueprint agents execute.",
    body: "We locate where your brand assets live - PDFs, CSVs, images, standards, toolkits, rules, data exports from existing systems. We gather everything into a staged repository and map what exists and how it's structured. From that we design the Platform Asset Pack: the strategic blueprint for the whole system. It's specified in enough detail that agents can execute it directly, under expert supervision. Every stage after this builds against the pack.",
    href: "#brand-ai-readiness",
    cta: "Assess readiness",
    image: usesPurposeUnderstandingImg,
  },
  {
    key: "brand_constitution_schema",
    label: "2. Constitute",
    stage: "Stage 2",
    phase: "Phase 1",
    heading: "CONSTITUTE",
    subheading: "Define the principles and architecture everything after refers to.",
    body: "We specify which AI models analyse which asset types - natural language processing for text, computer vision for images, icons, illustrations, and graphics, audio analysis for sound and video. We define what gets extracted: composition, colour, objects, themes, metadata, and context. We design the repository structure and the schema every asset must conform to. This becomes the constitution the whole build works from.",
    href: "#brand-ai-readiness",
    cta: "Assess readiness",
    image: usesSystemFramingImg,
  },
  {
    key: "brand_specification_atomisation",
    label: "3. Specify",
    stage: "Stage 3",
    phase: "Phase 2",
    heading: "SPECIFY",
    subheading: "Produce the interconnected brand data asset AI can read.",
    body: "We execute the atomisation pipeline against your staged assets. Every element is tagged, categorised, and structured against the Brando schema. Text becomes markdown. Images are analysed for composition, colour, objects, and context. Disambiguation and ambiguity testing runs throughout. The output is your brand's governed Brand Brain: an interconnected data asset that AI systems can read and act on, built and verified in parallel.",
    href: "#engine",
    cta: "See how we build",
    image: usesExecutionGenerationImg,
  },
  {
    key: "brand_model_validation_plan",
    label: "4. Plan",
    stage: "Stage 4",
    phase: "Phase 2",
    heading: "PLAN",
    subheading: "Set the standard Brando must meet before it goes live.",
    body: "Pipeline outputs and atomised datasets are tested, refined, and polished through iterative review. Our specialists identify failure cases, resolve ambiguities, and confirm the dataset meets our accuracy and governance standards. The result is Brando: your production-ready Brand Brain, delivered as an interconnected data asset and checked against a clear plan for what good looks like.",
    href: "#role-intent",
    cta: "See our standards",
    image: usesSpecificationDesignImg,
  },
  {
    key: "brand_model_build_execution",
    label: "5. Execute",
    stage: "Stage 5",
    phase: "Phase 3",
    heading: "EXECUTE",
    subheading: "Build out the Brando data asset against the plan, under expert supervision.",
    body: "We execute the build plan. Our specialists run each step, review the output, and correct course before the next one starts. Agents do the work at speed. Senior practitioners hold the standard, resolve judgement calls, and sign off each section against the plan. Nothing progresses on automation alone.",
    href: "#role-intent",
    cta: "See our approach",
    image: usesValidationEvaluationImg,
  },
  {
    key: "agentic_brand_implementation",
    label: "6. Implement",
    stage: "Stage 6",
    phase: "Phase 3",
    heading: "IMPLEMENT",
    subheading: "Operationalise into live brand operations and agentic systems.",
    body: "Convert identified opportunities into automated brand workflows and live agentic systems. Integrate into your existing tools, platforms, and orchestration layers. The system scales horizontally. The standards it works to remain under human control at every stage.",
    href: "#next-step",
    cta: "Request assessment",
    image: usesValidationEvaluationImg,
  },
] as const;

const personaPositioningCards = [
  {
    role: "CMO",
    heading: "For the CMO",
    body: "Your teams are already pasting brand guidelines into ChatGPT. The output looks plausible and drifts off-brand at scale, because fragments carry no governance. Every off-brand output spends trust you paid decades to build. Brando deploys an AI agent governed by your Brand Brain, enforcing your rules at the moment content is created, so approval happens in hours, not days. Brand drift becomes a measured score, not a feeling. In one enterprise workflow, a five-to-seven-day amend cycle was cut to minutes. Your team stops policing content and starts making campaigns.",
  },
  {
    role: "Head of Brand",
    heading: "For the Head of Brand",
    body: "You own the nuance, but a PDF cannot enforce it. Your Brand Brain holds the interlinked intent behind every rule, and the agent that reads it applies them. Update a policy once and the agent cascades that change across everything it governs, keeping the whole brand coherent. Every asset, tone decision, and exception stays versioned and auditable. Your brand stops being interpreted and starts being executed by an agent that knows it as well as you do.",
  },
  {
    role: "Chief Legal Officer",
    heading: "For the Chief Legal Officer",
    body: "AI-generated brand content is a liability surface: IP misuse, regulatory exposure, unapproved claims. The agent validates every output against your Brand Brain before content ships, not after complaints arrive. Full audit trails record what was generated, against which policy, and who approved it. Permissions restrict sensitive contexts. Built by a team with a governance and security operations background, led by an accredited AI Expert with the Law Society of Scotland.",
  },
  {
    role: "Head of AI",
    heading: "For the Head of AI",
    body: "You need brand knowledge your systems can actually consume. Brando delivers a structured, schema-defined Brand Brain served over Model Context Protocol. It ships inside an evaluation harness: validators, an LLM judge for red-teaming outputs, and drift measurement in one loop. It slots into your existing stack rather than replacing it, with deterministic and semantic evaluation of brand adherence. Speed and governance in the same pipeline, not in tension.",
  },
  {
    role: "CTO",
    heading: "For the CTO",
    body: "No new platform to run. Brando ships as code: the pipeline, the Brand Brain, the MCP endpoint, and the governing agent, all owned by you. Deploy in your infrastructure or take it as a container. The agent sits in your workflow via API, governing brand data across multiple systems as an independent layer outside your DAM and martech stack. You are never trapped in a vendor's asset store. Six stages, delivered through IBOM with an end.",
  },
  {
    role: "CFO",
    heading: "For the CFO",
    body: "Brand is a shortcut to trust, and trust is the asset nobody prices until it is damaged. The cost of governing it today is hidden in salaries and delay: every approval cycle stalls campaign revenue; every off-brand asset burns review hours. Brando automates governance at scale, cutting manual review cycles and the cost of brand inconsistency. You buy an asset, not a subscription.",
  },
] as const;

const postFilterChips = [
  "All",
  "Governance",
  "Knowledge",
  "Systems",
  "Operation",
  "MCP",
] as const;

const defaultUsesKey = usesTabs[0].key;
const latestPosts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const HOME_POST_INITIAL_COUNT = 3;
const HOME_POST_BATCH_SIZE = 3;
const page = {
  title,
  description,
  url: `${SITE_URL}/`,
  breadcrumbs: [{ name: "Home", url: `${SITE_URL}/` }],
};
---

<BaseLayout title={title} description={description} page={page}>
  <!-- 1. HERO -->
  <section class="home-hero bg-paper text-ink">
    <div class="container-wide home-hero__inner">
      <div class="eyebrow mb-10 text-left">MOVE FAST. STAY SAFE.</div>

      <div class="home-split-grid home-split-grid--hero">
        <h1 class="home-hero__title">
          You've created your brand. Now make AI operate it.
        </h1>

        <div>
          <p class="home-hero__lead">
            Advanced Analytica specialises in rewiring brands and business domains for AI-assisted operations. We capture the structure behind your brand and express it in a form AI can read and operate. We run the whole programme, with the speed to show results in weeks and a methodology that you can stand behind under scrutiny.
          </p>

          <div class="home-hero__actions">
            <a
              href="/company/contact/"
              class="home-hero__button"
            >
              Book a Conversation
            </a>

            <a href="#why" class="home-hero__secondary">
              <span>Why It Matters</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. WHY IT MATTERS -->
  <section id="why" class="bg-[#f3f0e8]">
    <div class="container-wide py-20">
      <div class="eyebrow mb-10 text-center">Why It Matters</div>

      <div class="home-split-grid">
        <div>
          <h2
            class="text-[clamp(1.75rem,3vw,3.2rem)] font-extrabold tracking-tight text-ink"
          >
            A PDF cannot govern an AI agent.
          </h2>
        </div>

        <div class="max-w-prose text-lg leading-relaxed text-steel md:text-xl">
          <p>
           The gap between a PDF and an AI-governed brand is where control is lost. AI doesn't interpret, it executes, and a PDF gives it nothing to execute against. So teams paste fragments into AI chabots. The output looks plausible. Then it drifts off-brand at scale, because fragments carry no governance.   </p>

          <p class="mt-6">
            Every off-brand output spends trust you paid decades to build. The fix isn't a stricter policy document or a better prompt. It's Brando<sup>&reg;</sup>: a governed Brand Brain delivered as an interconnected data asset, so AI expresses the brand correctly, everywhere, every time.
          </p>
        </div>
      </div>

      <div class="mt-12 flex items-center justify-center">
        <a
          href="#brand-ai-drift"
          class="inline-flex items-center justify-center gap-3 rounded-md bg-[#14B8A6] px-8 py-3 text-sm font-semibold tracking-[0.14em] uppercase text-paper shadow-outline transition-colors hover:bg-[#0F766E]"
          aria-label="Run an AI Drift Audit"
        >
          <span>Assess AI drift</span>
          <svg
            class="h-6 w-6 text-paper"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M10 3a1 1 0 0 1 1 1v10.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4.007 4.007a1 1 0 0 1-1.414 0L6.279 13.707a1 1 0 1 1 1.414-1.414L10 14.586V4a1 1 0 0 1 1-1z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. PERSONA POSITIONING -->
  <section id="persona-positioning" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="home-split-grid">
        <div>
          <div class="eyebrow mb-6 text-[#14B8A6]">Positioning</div>
          <h2
            class="text-[clamp(2.1rem,4vw,4rem)] font-semibold leading-[1.05] tracking-tight text-ink"
          >
            Brando gives every owner a reason to act.
          </h2>
        </div>

        <div
          class="rounded-2xl border border-ink/10 bg-[#f3f0e8] p-8 shadow-outline"
        >
          <p class="text-lg leading-relaxed text-ink/75 md:text-xl">
            A brand is a compression of information and a shortcut to trust.
            Compressed into PDFs, it means ten different things to ten different
            people, and the trust leaks out.
          </p>
          <p class="mt-6 text-lg leading-relaxed text-ink/75 md:text-xl">
            Brando converts brand identity into a governed Brand Brain: an
            interconnected data asset. An AI agent governed by your policies
            ensures every output reflects your intent, checked, recorded, and
            auditable at the moment content is created. One source of truth, one
            meaning. Delivered as code the client owns. No licences, no lock-in.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          personaPositioningCards.map((card) => (
            <article class="flex min-h-full flex-col rounded-2xl border border-ink/10 bg-[#f3f0e8] p-7 shadow-outline">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-[#14B8A6]">
                {card.role}
              </div>
              <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
                {card.heading}
              </h3>
              <p class="mt-5 text-base leading-relaxed text-steel">
                {card.body}
              </p>
            </article>
          ))
        }
      </div>

      <p
        class="mx-auto mt-14 max-w-4xl text-center text-[clamp(1.9rem,4vw,3.8rem)] font-semibold leading-none tracking-tight text-ink"
      >
        Move fast. Stay safe.
      </p>
    </div>
  </section>

  <!-- 4. DIAGNOSTIC OFFER -->
  <section
    id="brand-ai-drift"
    class="bg-gradient-to-br from-black via-[#0b0e14] to-[#171b24] text-paper"
  >
    <div class="container-wide py-20">
      <div class="home-split-grid home-split-grid--center">
        <div>
          <div class="eyebrow mb-6 text-[#14B8A6]">Diagnostic Offer</div>
          <h2
            class="max-w-[12ch] text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[1.02] tracking-tight text-paper"
          >
            Run an AI Drift Audit.
          </h2>
          <p
            class="mt-8 max-w-[62ch] text-lg leading-relaxed text-paper/75 md:text-xl"
          >
            Before AI acts on your behalf, you need to know whether your brand
            rules are clear enough to govern it.
          </p>
          <p
            class="mt-6 max-w-[62ch] text-lg leading-relaxed text-paper/75 md:text-xl"
          >
            Our AI Drift Audit reviews your standards, toolkits,
            approval rules, and priority AI use cases. You see where AI can
            follow your brand, where ambiguity appears, and where stronger
            controls are needed first.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/brand-ai-drift-audit/"
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#14B8A6] px-6 py-3 text-xs font-semibold leading-none tracking-[0.14em] uppercase text-paper shadow-outline transition-colors hover:bg-[#0F766E]"
            >
              Request assessment
              <svg
                class="h-4 w-4"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 10h12"></path>
                <path d="M12 6l4 4-4 4"></path>
              </svg>
            </a>
            <a
              href="#role-intent"
              class="inline-flex items-center justify-center gap-3 rounded-md bg-[#14B8A6] px-8 py-3 text-sm font-semibold tracking-[0.14em] uppercase text-paper shadow-outline transition-colors hover:bg-[#0F766E]"
            >
              What we test
              <svg
                class="h-6 w-6 text-paper"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M10 3a1 1 0 0 1 1 1v10.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4.007 4.007a1 1 0 0 1-1.414 0L6.279 13.707a1 1 0 1 1 1.414-1.414L10 14.586V4a1 1 0 0 1 1-1z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <div
          class="rounded-2xl border border-paper/10 bg-paper/5 p-8 shadow-outline backdrop-blur"
        >
          <div
            class="text-sm font-semibold tracking-[0.2em] uppercase text-[#14B8A6]"
          >
            You get
          </div>
          <ul class="mt-8 space-y-6 text-paper/80">
            <li class="flex gap-4">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                >A structured review of your brand standards, toolkits,
                policies, and AI use cases.</span
              >
            </li>
            <li class="flex gap-4">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                >A readiness score across machine-readability, ambiguity, and AI
                control.</span
              >
            </li>
            <li class="flex gap-4">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                >A risk map showing where AI may misread, over-interpret, or
                ignore your brand rules.</span
              >
            </li>
            <li class="flex gap-4">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                >A practical action plan with Critical, High, Medium, and Low
                priorities.</span
              >
            </li>
            <li class="flex gap-4">
              <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                >A short readout with recommended next steps into Brando, IBOM<sup>&reg;</sup>
                delivery, and governed workflows.</span
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. ROLE-INTENT TESTING -->
  <section id="role-intent" class="bg-paper text-ink">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center">Role-Intent Testing</div>
      <h2
        class="mx-auto max-w-5xl text-center text-[clamp(2.4rem,5vw,4.5rem)] font-semibold tracking-tight text-ink"
      >
        We test your brand against the roles and intents your AI will meet in
        the real world.
      </h2>
      <p
        class="mx-auto mt-8 max-w-[82ch] text-center text-lg leading-relaxed text-ink/70 md:text-xl"
      >
        Your brand does not fail in theory. It fails in moments. A customer asks
        for reassurance. A journalist asks for proof. A regulator expects
        precision. A sales team pushes for conversion. An AI agent tries to
        summarise, rewrite, compare, recommend, or respond.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-ink/10 bg-fog p-8">
          <div
            class="text-xs font-semibold tracking-[0.2em] uppercase text-[#14B8A6]"
          >
            Roles
          </div>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
            Who is interacting with your brand?
          </h3>
          <p class="mt-4 text-base leading-relaxed text-steel">
            Customers, employees, journalists, partners, regulators, agency
            teams, sales teams, support agents, and AI agents.
          </p>
        </div>

        <div class="rounded-2xl border border-ink/10 bg-fog p-8">
          <div
            class="text-xs font-semibold tracking-[0.2em] uppercase text-[#14B8A6]"
          >
            Intents
          </div>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
            What are they intending to do?
          </h3>
          <p class="mt-4 text-base leading-relaxed text-steel">
            Compare, complain, buy, escalate, summarise, localise, request
            proof, push conversion, create content, or ask for an exception.
          </p>
        </div>
      </div>

      <p
        class="mx-auto mt-10 max-w-[72ch] text-center text-lg leading-relaxed text-ink/70"
      >
        You see which rules hold, where toolkits create ambiguity, and where
        stronger controls are needed.
      </p>

      <div class="mt-12 flex items-center justify-center">
        <a
          href="#concerns"
          class="inline-flex items-center justify-center gap-3 rounded-md bg-[#14B8A6] px-8 py-3 text-sm font-semibold tracking-[0.14em] uppercase text-paper shadow-outline transition-colors hover:bg-[#0F766E]"
        >
          <span>See how Brando works</span>
          <svg
            class="h-6 w-6 text-paper"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M10 3a1 1 0 0 1 1 1v10.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4.007 4.007a1 1 0 0 1-1.414 0L6.279 13.707a1 1 0 1 1 1.414-1.414L10 14.586V4a1 1 0 0 1 1-1z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. HOW BRANDO WORKS -->
  <section id="concerns" class="bg-slate text-paper">
    <div class="container-wide py-20">
      <div class="eyebrow mb-6 text-center opacity-70">How Brando Works</div>
      <h2
        class="text-center text-[clamp(2.5rem,5vw,4.75rem)] font-semibold tracking-tight text-paper"
      >
        From brand disorder to controlled AI operations
      </h2>
      <p
        class="mx-auto mt-10 max-w-[90ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
      >
        Most businesses cannot scale what they cannot codify. We move your brand
        standards, expert judgement, and operating rules into a governed
        intelligence layer. Your knowledge. Your rules. Under your control.
      </p>

      <div class="mt-14 grid gap-4 lg:grid-cols-3">
        <div
          class="rounded-2xl border border-paper/15 bg-ink/30 p-6 shadow-outline backdrop-blur"
        >
          <h4 class="text-lg font-semibold tracking-tight text-paper">
            Brando Mapping
          </h4>
          <p class="mt-3 text-base leading-relaxed text-paper/75">
            We map the rules, approvals, exceptions, and judgement your teams
            already use. The system starts with how your business really works,
            not a generic template.
          </p>
        </div>

        <div
          class="rounded-2xl border border-paper/15 bg-ink/30 p-6 shadow-outline backdrop-blur"
        >
          <h4 class="text-lg font-semibold tracking-tight text-paper">
            Brando Data Modelling
          </h4>
          <p class="mt-3 text-base leading-relaxed text-paper/75">
            We turn brand and business logic into an interconnected,
            machine-readable data asset. So your AI gets rules it can
            consistently interpret and follow in practice.
          </p>
        </div>

        <div
          class="rounded-2xl border border-paper/15 bg-ink/30 p-6 shadow-outline backdrop-blur"
        >
          <h4 class="text-lg font-semibold tracking-tight text-paper">
            Brando Deployment
          </h4>
          <p class="mt-3 text-base leading-relaxed text-paper/75">
            We build, test, and deploy your Brando, embedding approved
            specifications into controlled workflows, review paths, and agent
            behaviours.
          </p>
        </div>
      </div>

      <div class="mt-16 border-t border-paper/20 pt-16">
        <h3
          class="text-center text-3xl font-semibold tracking-tight text-paper md:text-4xl"
        >
          Building Brando through IBOM
        </h3>
        <p
          class="mx-auto mt-6 max-w-[90ch] text-center text-lg leading-relaxed text-paper/80 md:text-xl"
        >
          We deliver Brando through IBOM in two connected phases. The first
          defines and validates your knowledge and specifications. The second
          turns them into governed workflows, controls, and operating
          capability.
        </p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <div
          class="rounded-2xl border border-paper/15 bg-ink/30 p-10 shadow-outline backdrop-blur"
        >
          <div
            class="text-lg font-semibold tracking-[0.2em] uppercase text-[#14B8A6]"
          >
            Phase 1
          </div>
          <div class="mt-4 text-2xl font-semibold tracking-tight text-paper">
            Brand Rewiring
          </div>
          <p class="mt-4 text-paper/80">
            We transform standards, toolkits, approvals, and expert judgement
            into structured knowledge your business owns without vendor lock-in.
          </p>
          <ul class="mt-6 space-y-4 text-paper/75">
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                ><b>Codify</b> brand and business knowledge into high-fidelity structured
                records.</span
              >
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[#14B8A6]"
              ></span>
              <span
                ><b>Construct</b> policy structures, role-intent scenarios, and machine-readable
                rules.</span
              >
            </li>
            <li class="flex gap-3">
