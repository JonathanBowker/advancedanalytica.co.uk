---
import '../../styles/global.css';
import { TypebotStandardEmbed } from '../../components/forms/TypebotStandardEmbed.jsx';
import { isLocalHostname } from '../../lib/hosts';
import { getTenantPortalService, getTenantThemeCss } from '../../lib/tenants';

export const prerender = false;

const tenant = Astro.locals.tenant;
const user = Astro.locals.user;
const slug = Astro.params.slug ?? '';
const service = getTenantPortalService(tenant, slug);

function getTypebotId(embedUrl?: string) {
  if (!embedUrl) return '';

  try {
    const parsed = new URL(embedUrl);
    if (!/(\.|^)typebot\.(co|com)$/i.test(parsed.hostname)) return '';
    return parsed.pathname.split('/').filter(Boolean)[0] ?? '';
  } catch {
    return '';
  }
}

function isLocalPreviewRequest(request: Request) {
  return isLocalHostname(new URL(request.url).hostname);
}

if (!service) {
  return Astro.redirect('/login');
}

const previewRequested = Astro.url.searchParams.get('preview') === '1';
const previewMode = !user && previewRequested && isLocalPreviewRequest(Astro.request);
const canViewEmbed = Boolean(user) || previewMode;
const displayUserEmail = user?.email ?? (previewMode ? 'local-preview@advancedanalytica.test' : '');
const nextPath = `/forms/${service.slug}`;
const embeddedFormUrl = service.embeddedFormUrl ?? `/portal/services/${service.slug}`;
const iframeTitle = `${service.name} embedded form`;
const isExternalEmbed = Boolean(service.embeddedFormUrl);
const typebotId = getTypebotId(service.embeddedFormUrl);
const usesTypebotEmbed = Boolean(typebotId);
const useNativeDisneyCapture = service.slug === 'brand-readiness-assessment';
const submitted = Astro.url.searchParams.get('submitted') === '1';
const submissionId = Astro.url.searchParams.get('submission') ?? '';
const formError = Astro.url.searchParams.get('error') ?? '';
const userMetadata = user?.user_metadata ?? {};

function firstProfileValue(...keys: string[]) {
  for (const key of keys) {
    const value = userMetadata[key];
    if (typeof value === 'string' && value.trim()) return value.trim();
  }

  return '';
}

const displayUserName =
  firstProfileValue('full_name', 'name', 'display_name') ||
  (previewMode ? 'Local preview user' : '');
const displayUserCompany =
  firstProfileValue('company', 'company_name', 'organisation', 'organization') ||
  (previewMode ? 'Advanced Analytica Preview' : '');
const creativeWorkTypes = [
  ['social_media_post', 'Social media post'],
  ['email_campaign', 'Email campaign'],
  ['newsletter', 'Newsletter'],
  ['brochure_print', 'Brochure / print'],
  ['banner_display_ad', 'Banner / display ad'],
  ['blog_vlog', 'Blog / Vlog'],
  ['other', 'Other'],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{service.name} | {tenant.name}</title>
    <meta name="description" content={service.summary} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" sizes="any" />
    <style is:inline set:html={getTenantThemeCss(tenant)}></style>
    <style is:inline>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #fff;
      }

      body {
        font-family: var(--font-body, sans-serif);
      }

      .embed-shell {
        min-height: 100vh;
        background: #fff;
      }

      .embed-frame,
      .embed-typebot {
        width: 100%;
        min-height: 100vh;
        border: 0;
        display: block;
        background: #fff;
      }

      .access-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background:
          radial-gradient(circle at top, rgba(20, 184, 166, 0.08), transparent 34%),
          #f8fafc;
      }

      .access-card {
        width: min(100%, 460px);
        border-radius: 28px;
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: rgba(255, 255, 255, 0.96);
        padding: 32px;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
      }

      .access-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-accent);
      }

      .access-title {
        margin: 14px 0 0;
        font-family: var(--font-display, sans-serif);
        font-size: clamp(2rem, 6vw, 3rem);
        line-height: 0.98;
        color: #0f172a;
      }

      .access-copy {
        margin: 14px 0 0;
        font-size: 0.98rem;
        line-height: 1.75;
        color: #475569;
      }

      .access-form {
        margin-top: 28px;
        display: grid;
        gap: 16px;
      }

      .access-field {
        display: grid;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #0f172a;
      }

      .access-input {
        width: 100%;
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, 0.34);
        background: #fff;
        padding: 14px 16px;
        font: inherit;
        color: #0f172a;
        outline: none;
      }

      .access-input:focus {
        border-color: var(--color-accent);
      }

      .access-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .access-button,
      .access-link {
        border-radius: 999px;
        padding: 13px 18px;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
      }

      .access-button {
        border: 0;
        background: var(--color-accent);
        color: #fff;
        cursor: pointer;
      }

      .access-button:disabled {
        cursor: not-allowed;
        opacity: 0.65;
      }

      .access-link {
        border: 1px solid rgba(148, 163, 184, 0.34);
        color: #0f172a;
        background: #fff;
      }

      .access-status {
        display: none;
        border-radius: 18px;
        border: 1px solid transparent;
        padding: 14px 16px;
        font-size: 0.92rem;
        line-height: 1.6;
      }

      .access-status.is-visible {
        display: block;
      }

      .access-status.is-success {
        border-color: #a7f3d0;
        background: #ecfdf5;
        color: #065f46;
      }

      .access-status.is-error {
        border-color: #fecaca;
        background: #fff1f2;
        color: #9f1239;
      }

      .preview-chip {
        position: fixed;
        top: 14px;
        z-index: 20;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.88);
        color: #fff;
        padding: 8px 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .preview-chip {
        right: 14px;
      }

      .embed-signout {
        position: fixed;
        top: 14px;
        right: 14px;
        z-index: 30;
        border-radius: 999px;
        border: 1px solid rgba(15, 23, 42, 0.12);
        background: rgba(255, 255, 255, 0.9);
        color: rgba(15, 23, 42, 0.72);
        padding: 8px 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        opacity: 0.34;
        transition:
          opacity 160ms ease,
          color 160ms ease,
          background 160ms ease;
      }

      .embed-signout:hover,
      .embed-signout:focus-visible {
        background: #fff;
        color: #0f172a;
        opacity: 1;
      }

      .native-shell {
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 8%, rgba(20, 184, 166, 0.12), transparent 28%),
          linear-gradient(135deg, #f8fafc 0%, #fff 48%, #eef7f6 100%);
        padding: 28px 18px 48px;
      }

      .native-card {
        width: min(100%, 780px);
        margin: 0 auto;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 28px 90px rgba(15, 23, 42, 0.12);
        overflow: hidden;
      }

      .native-header {
        padding: clamp(28px, 6vw, 54px);
        background: #080b10;
        color: #fff;
      }

      .native-label {
        color: #14b8a6;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .native-title {
        margin: 16px 0 0;
        font-family: var(--font-display, sans-serif);
        font-size: clamp(2.4rem, 8vw, 5rem);
        line-height: 0.92;
        letter-spacing: -0.06em;
      }

      .native-copy {
        max-width: 58ch;
        margin: 20px 0 0;
        color: rgba(255, 255, 255, 0.72);
        font-size: 1rem;
        line-height: 1.75;
      }

      .native-form,
      .native-thanks {
        display: grid;
        gap: 22px;
        padding: clamp(24px, 5vw, 42px);
      }

      .native-grid {
        display: grid;
        gap: 18px;
      }

      @media (min-width: 760px) {
        .native-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .native-field {
        display: grid;
        gap: 8px;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 750;
      }

      .native-field span {
        display: inline-flex;
        gap: 6px;
        align-items: baseline;
      }

      .native-field small {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .native-input,
      .native-select,
      .native-file {
        width: 100%;
        border: 1px solid rgba(148, 163, 184, 0.38);
        border-radius: 18px;
        background: #fff;
        color: #0f172a;
        font: inherit;
        padding: 14px 16px;
        outline: none;
        transition:
          border-color 160ms ease,
          box-shadow 160ms ease;
      }

      .native-input[readonly] {
        color: #475569;
        background: #f8fafc;
      }

      .native-input:focus,
      .native-select:focus,
      .native-file:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.13);
      }

      .native-file {
        padding: 13px;
      }

      .native-note,
      .native-error {
        border-radius: 18px;
        padding: 14px 16px;
        font-size: 0.92rem;
        line-height: 1.6;
      }

      .native-note {
        border: 1px solid rgba(20, 184, 166, 0.2);
        background: rgba(20, 184, 166, 0.08);
        color: #0f766e;
      }

      .native-error {
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #9f1239;
      }

      .native-submit {
        justify-self: start;
        border: 0;
        border-radius: 999px;
        background: #14b8a6;
        color: #041311;
        cursor: pointer;
        font-size: 0.88rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        padding: 15px 22px;
        text-transform: uppercase;
        transition:
          background 160ms ease,
          transform 160ms ease;
      }

      .native-submit:hover,
      .native-submit:focus-visible {
        background: #2dd4bf;
        transform: translateY(-1px);
      }

      .native-thanks h1 {
        margin: 0;
        color: #0f172a;
        font-family: var(--font-display, sans-serif);
        font-size: clamp(2.1rem, 7vw, 4.4rem);
        line-height: 0.95;
        letter-spacing: -0.055em;
      }

      .native-thanks p {
        margin: 0;
        color: #475569;
        font-size: 1rem;
        line-height: 1.8;
      }
    </style>
  </head>
  <body>
    {canViewEmbed ? (
      <main class="embed-shell">
        {user ? (
          <a class="embed-signout" href={`/logout?next=${encodeURIComponent(nextPath)}`}>
            Sign out
          </a>
        ) : null}
        {previewMode ? <div class="preview-chip">Local preview</div> : null}
        {useNativeDisneyCapture ? (
          <section class="native-shell">
            <div class="native-card">
              {submitted ? (
                <div class="native-thanks">
                  <div class="native-label">MagiKit received</div>
                  <h1>Thank you. Your creative is in the queue.</h1>
                  <p>
                    MagiKit has received your Disney Brand Compliance pre-screening submission. We’ll process the creative work against the evidence-first pipeline and prepare the next review output.
                  </p>
                  {submissionId ? (
                    <p>
                      Submission reference: <strong>{submissionId}</strong>
                    </p>
                  ) : null}
                </div>
              ) : (
                <>
                  <header class="native-header">
                    <div class="native-label">Disney creative pre-screen</div>
                    <h1 class="native-title">Upload creative work for MagiKit.</h1>
                    <p class="native-copy">
                      Submit a PDF, DOCX, PNG, or JPEG creative. We’ll package your profile details and intake context into the Disney compliance pipeline manifest.
                    </p>
                  </header>

                  <form class="native-form" action={`${nextPath}/submit`} method="post" enctype="multipart/form-data">
                    {formError ? (
                      <div class="native-error">
                        {formError === 'file_type'
                          ? 'Upload a PDF, DOCX, PNG, or JPEG file.'
                          : formError === 'file_size'
                            ? 'The file is too large. Upload a file under 25MB.'
                            : formError === 'missing_file'
                              ? 'Choose a creative file to upload.'
                              : formError === 'pipeline'
                                ? 'MagiKit could not queue that file for processing. Please try again.'
                                : formError === 'date'
                                  ? 'Enter valid activity start and end dates. The end date must be on or after the start date.'
                                : 'We could not receive that submission. Please check the form and try again.'}
                      </div>
                    ) : null}

                    <div class="native-grid">
                      <label class="native-field">
                        <span>Name <small>from profile</small></span>
                        <input
                          class="native-input"
                          type="text"
                          name="name"
                          autocomplete="name"
                          required
                          value={displayUserName}
                          placeholder="Your name"
                        />
                      </label>

                      <label class="native-field">
                        <span>Email <small>signed in</small></span>
                        <input
                          class="native-input"
                          type="email"
                          name="email"
                          autocomplete="email"
                          required
                          readonly
                          value={displayUserEmail}
                        />
                      </label>

                      <label class="native-field">
                        <span>Company <small>from profile</small></span>
                        <input
                          class="native-input"
                          type="text"
                          name="company"
                          autocomplete="organization"
                          required
                          value={displayUserCompany}
                          placeholder="Company"
                        />
                      </label>

                      <label class="native-field">
                        Disney property
                        <select class="native-select" name="disneyProperty" required>
                          <option value="disneyland_hotel" selected>Disneyland Hotel</option>
                        </select>
                      </label>

                      <label class="native-field">
                        Activity start date
                        <input
                          class="native-input"
                          type="date"
                          name="activityStartDate"
                          required
                        />
                      </label>

                      <label class="native-field">
                        Activity end date
                        <input
                          class="native-input"
                          type="date"
                          name="activityEndDate"
                          required
                        />
                      </label>
                    </div>

                    <label class="native-field">
                      Type of creative work
                      <select class="native-select" name="creativeType" required>
                        <option value="">Select a format</option>
                        {creativeWorkTypes.map(([value, label]) => (
                          <option value={value}>{label}</option>
                        ))}
                      </select>
                    </label>

                    <label class="native-field">
                      Upload creative work
                      <input
                        class="native-file"
                        type="file"
                        name="creative"
                        accept=".pdf,.docx,.png,.jpg,.jpeg,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg"
                        required
                      />
                    </label>

                    <div class="native-note">
                      Accepted files: PDF, DOCX, PNG, JPEG. This is a pre-screening workflow, not final Disney approval.
                    </div>

                    <button class="native-submit" type="submit">Send to MagiKit</button>
                  </form>
                </>
              )}
            </div>
          </section>
        ) : usesTypebotEmbed ? (
          <div class="embed-typebot">
            <TypebotStandardEmbed client:only="react" typebot={typebotId} />
          </div>
        ) : (
          <iframe
            src={embeddedFormUrl}
            title={iframeTitle}
            class="embed-frame"
            loading="eager"
            referrerpolicy={isExternalEmbed ? 'strict-origin-when-cross-origin' : 'same-origin'}
          ></iframe>
        )}
      </main>
    ) : (
      <main class="access-shell">
        <section class="access-card">
          <div class="access-label">Magic link access</div>
          <h1 class="access-title">{service.name}</h1>
          <p class="access-copy">
            Enter your work email and we’ll send a tenant-aware magic link that brings you straight back to this form.
          </p>

          <form id="embedded-form-access" class="access-form">
            <label class="access-field">
              Work email
              <input
                id="embedded-form-email"
                type="email"
                name="email"
                autocomplete="email"
                required
                placeholder="name@company.com"
                class="access-input"
              />
            </label>

            <div class="access-actions">
              <button
                id="embedded-form-submit"
                type="submit"
                class="access-button"
              >
                Send magic link
              </button>
              <a
                href={`/login?next=${encodeURIComponent(nextPath)}`}
                class="access-link"
              >
                Open full login
              </a>
            </div>

            <p id="embedded-form-status" class="access-status"></p>
          </form>
        </section>
      </main>
    )}

    {!canViewEmbed ? (
      <script is:inline define:vars={{ nextPath }}>
        const form = document.getElementById('embedded-form-access');
        const emailInput = document.getElementById('embedded-form-email');
        const submitButton = document.getElementById('embedded-form-submit');
        const status = document.getElementById('embedded-form-status');

        if (
          form instanceof HTMLFormElement &&
          emailInput instanceof HTMLInputElement &&
          submitButton instanceof HTMLButtonElement &&
          status instanceof HTMLElement
        ) {
          const setStatus = (message, tone) => {
            status.textContent = message;
            status.classList.remove('is-success', 'is-error');
            status.classList.add('is-visible', tone === 'success' ? 'is-success' : 'is-error');
          };

          form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const email = emailInput.value.trim();
            if (!email) {
              setStatus('Enter a work email address.', 'error');
              return;
            }

            submitButton.disabled = true;
            submitButton.textContent = 'Sending...';
            status.classList.remove('is-visible', 'is-success', 'is-error');

            try {
              const response = await fetch('/auth/magic-link', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  email,
                  nextUrl: nextPath,
                }),
              });

              const payload = await response.json().catch(() => null);

              if (!response.ok) {
                throw new Error(payload?.error || 'Failed to send magic link.');
              }

              setStatus('Check your email for the sign-in link, then return here to open the form.', 'success');
              form.reset();
            } catch (error) {
              const message = error instanceof Error ? error.message : 'Failed to send magic link.';
              setStatus(message, 'error');
            } finally {
              submitButton.disabled = false;
              submitButton.textContent = 'Send magic link';
            }
          });
        }
      </script>
    ) : null}
  </body>
</html>
