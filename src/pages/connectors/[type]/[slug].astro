---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import components from '../../../lib/mdx/components';
import { SITE_URL } from '../../../lib/seo/site';

export async function getStaticPaths() {
  const connectors = await getCollection('connectors');
  return connectors.map((connector) => {
    const slug = connector.id.split('/').at(-1)?.replace(/\.md$/, '') ?? connector.data.connector_slug;
    return {
      params: {
        type: connector.data.connector_type === 'source' ? 'sources' : 'destinations',
        slug
      },
      props: { connector }
    };
  });
}

const { connector } = Astro.props as { connector: CollectionEntry<'connectors'> };
const { Content } = await connector.render();
const data = connector.data;
const section = data.connector_type === 'source' ? 'sources' : 'destinations';
const pageSlug = connector.id.split('/').at(-1)?.replace(/\.md$/, '') ?? data.connector_slug;
const typeLabel = data.connector_type === 'source' ? 'Source connector' : 'Destination connector';
const title = `${data.connector_name} ${data.connector_type} connector`;
const description = data.connector_type === 'source'
  ? `Set up ${data.connector_name} as a source and move its data into your chosen destination.`
  : `Send governed data into ${data.connector_name} with a clear, practical setup guide.`;
const url = `${SITE_URL}/connectors/${section}/${pageSlug}/`;
const page = {
  title,
  description,
  url,
  breadcrumbs: [
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Data connectors', url: `${SITE_URL}/connectors/` },
    { name: data.connector_name, url }
  ]
};
---

<BaseLayout title={title} description={description} page={page}>
  <section class="border-b border-fog bg-surface py-12 md:py-16">
    <div class="container-wide">
      <a href="/connectors/" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#0F766E] hover:text-[#14B8A6]">← All connectors</a>
      <div class="mt-8 grid gap-8 md:grid-cols-[96px_1fr] md:items-center">
        <div class="flex h-24 w-24 items-center justify-center rounded-2xl border border-fog bg-white p-4 shadow-sm">
          {data.logo ? (
            <img src={data.logo} alt={`${data.connector_name} logo`} class="h-full w-full object-contain" />
          ) : (
            <span class="text-2xl font-semibold text-steel">{data.connector_name.slice(0, 2).toUpperCase()}</span>
          )}
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#14B8A6]">{typeLabel}</p>
          <h1 class="mt-3 text-[clamp(2.25rem,5vw,4.25rem)] font-semibold tracking-tight text-ink">{data.connector_name}</h1>
          <p class="mt-4 max-w-[64ch] text-lg leading-relaxed text-steel">{description}</p>
          <div class="mt-6 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full border border-fog bg-white px-3 py-1.5">Version {data.version}</span>
            {data.support_level ? <span class="rounded-full border border-fog bg-white px-3 py-1.5">{data.support_level.replaceAll('_', ' ')}</span> : null}
            {data.release_stage ? <span class="rounded-full border border-fog bg-white px-3 py-1.5">{data.release_stage.replaceAll('_', ' ')}</span> : null}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <div class="grid gap-12 xl:grid-cols-[minmax(0,860px)_280px] xl:items-start">
      <article class="prose connector-prose min-w-0 max-w-none overflow-hidden">
        <Content components={components} />
      </article>
      <aside class="rounded-xl border border-fog bg-surface p-6 xl:sticky xl:top-28">
        <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">Connector record</h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div><dt class="text-steel">Type</dt><dd class="mt-1 font-medium capitalize text-ink">{data.connector_type}</dd></div>
          <div><dt class="text-steel">Version</dt><dd class="mt-1 font-medium text-ink">{data.version}</dd></div>
          <div><dt class="text-steel">Rewrite status</dt><dd class="mt-1 font-medium capitalize text-ink">{data.rewrite_status}</dd></div>
        </dl>
        {data.documentation_url ? (
          <a href={data.documentation_url} target="_blank" rel="noreferrer" class="mt-6 inline-flex text-sm font-semibold text-[#0F766E] hover:text-[#14B8A6]">
            View source documentation ↗
          </a>
        ) : null}
      </aside>
    </div>
  </section>

  <style>
    .connector-prose :global(h1:first-child) { display: none; }
    .connector-prose :global(img:first-of-type) { display: none; }
    .connector-prose :global(table) { display: block; overflow-x: auto; white-space: nowrap; }
    .connector-prose :global(pre) { max-width: 100%; overflow-x: auto; }
    .connector-prose :global(code) { overflow-wrap: anywhere; }
    .connector-prose :global(details) { margin: 1.5rem 0; border: 1px solid var(--color-fog); border-radius: 0.75rem; padding: 1rem 1.25rem; }
    .connector-prose :global(summary) { cursor: pointer; font-weight: 600; color: var(--color-ink); }
  </style>
</BaseLayout>
