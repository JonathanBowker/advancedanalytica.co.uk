---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getTenantPortalService } from '../../../lib/tenants';

export const prerender = false;

const tenant = Astro.locals.tenant;
const user = Astro.locals.user;
const slug = Astro.params.slug ?? '';
const service = getTenantPortalService(tenant, slug);

if (!service) {
  return Astro.redirect('/portal');
}

let submission:
  | {
      submittedAt: string;
      values: Record<string, string>;
    }
  | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  submission = {
    submittedAt: new Date().toISOString(),
    values: Object.fromEntries(
      service.fields.map((field) => [field.name, String(formData.get(field.name) ?? '').trim()]),
    ),
  };
}
---
<PortalLayout
  title={`${service.name} | ${tenant.name}`}
  description={service.summary}
  tenant={tenant}
  signedIn={Boolean(user)}
>
  <section class="mx-auto w-[min(1120px,92vw)] py-10 lg:py-14">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <aside class="rounded-[2rem] border border-[color:var(--color-fog)] bg-[#0d1420] p-8 text-paper shadow-[var(--shadow-outline)]">
        <div class="text-xs font-semibold uppercase tracking-[0.22em] text-white/60">
          Tenant service
        </div>
        <h1 class="mt-4 font-display text-[clamp(2.1rem,3vw,3.3rem)] leading-[1.08]">
          {service.name}
        </h1>
        <p class="mt-4 text-base leading-7 text-white/72">{service.description}</p>
        <div class="mt-8 rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
          <div class="text-xs uppercase tracking-[0.22em] text-white/55">AI handoff</div>
          <p class="mt-3 text-sm leading-7 text-white/72">{service.aiUse}</p>
        </div>
        <a href="/portal" class="mt-8 inline-flex items-center rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-paper transition hover:border-white/40">
          Back to portal
        </a>
      </aside>

      <div class="rounded-[2rem] border border-[color:var(--color-fog)] bg-surface p-8 shadow-[var(--shadow-soft)]">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-accent)]">
              Protected intake
            </div>
            <h2 class="mt-3 font-display text-3xl text-ink">Collect request data</h2>
          </div>
          <div class="rounded-full border border-[color:var(--color-fog)] px-4 py-2 text-xs uppercase tracking-[0.18em] text-slate">
            {tenant.slug}
          </div>
        </div>

        <form method="POST" class="mt-8 grid gap-5">
          {service.fields.map((field) => (
            <label class="grid gap-2 text-sm font-semibold text-ink">
              {field.label}
              {field.type === 'textarea' ? (
                <textarea
                  name={field.name}
                  rows={field.rows ?? 4}
                  required={field.required}
                  placeholder={field.placeholder}
                  class="rounded-2xl border border-[color:var(--color-fog)] bg-white px-4 py-3 text-base font-normal text-ink outline-none transition focus:border-[color:var(--color-accent)]"
                >
                  {submission?.values[field.name] ?? ''}
                </textarea>
              ) : (
                <input
                  type={field.type}
                  name={field.name}
                  required={field.required}
                  value={submission?.values[field.name] ?? ''}
                  placeholder={field.placeholder}
                  class="rounded-2xl border border-[color:var(--color-fog)] bg-white px-4 py-3 text-base font-normal text-ink outline-none transition focus:border-[color:var(--color-accent)]"
                />
              )}
              {field.help ? <span class="text-xs font-normal text-slate">{field.help}</span> : null}
            </label>
          ))}

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button
              type="submit"
              class="inline-flex items-center rounded-full bg-[color:var(--color-accent)] px-5 py-3 text-sm font-semibold text-paper transition hover:bg-[color:var(--color-accent-deep)]"
            >
              Prepare AI payload
            </button>
            <span class="text-sm text-slate">This route is protected by middleware and SSR session checks.</span>
          </div>
        </form>

        {submission ? (
          <section class="mt-8 rounded-[1.5rem] border border-[color:var(--color-fog)] bg-background/70 p-6">
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-accent)]">
              Prepared payload
            </div>
            <p class="mt-3 text-sm leading-7 text-slate">
              Submitted at {submission.submittedAt}. This is the structured payload that can be handed to an AI API from the protected portal layer.
            </p>
            <pre class="mt-4 overflow-x-auto rounded-2xl bg-[#0d1420] p-5 text-sm text-white/85">{JSON.stringify({
              tenant: tenant.slug,
              service: service.slug,
              user: user?.email ?? null,
              submittedAt: submission.submittedAt,
              input: submission.values,
            }, null, 2)}</pre>
          </section>
        ) : null}
      </div>
    </div>
  </section>
</PortalLayout>
