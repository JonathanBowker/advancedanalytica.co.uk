---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getPortalAccess } from '../../../lib/portalAccess';
import { getTenantPortalServices } from '../../../lib/tenants';

export const prerender = false;

const tenant = Astro.locals.tenant;
const user = Astro.locals.user;
const access = getPortalAccess(user);
const services = getTenantPortalServices(tenant);
const title = `My Account | ${tenant.name}`;
const description = `Signed-in account profile and portal access summary for ${tenant.name}.`;

function formatDate(value: string | null | undefined) {
  if (!value) return 'Not available';

  try {
    return new Intl.DateTimeFormat('en-GB', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'Europe/London',
    }).format(new Date(value));
  } catch {
    return value;
  }
}

const roleLabels = access.roles.length ? access.roles : ['client'];
const portalAreas = [
  {
    title: 'Service workflows',
    description: 'Use the provisioned intake workflows available for this tenant.',
    href: '/portal',
    allowed: true,
    label: `${services.length} service${services.length === 1 ? '' : 's'}`,
  },
  {
    title: 'Products',
    description: 'Review the product, framework, service, and protected internal tools available to this account.',
    href: '/portal/products/',
    allowed: true,
    label: 'Product catalogue',
  },
  {
    title: 'Offer Builder',
    description: 'Create internal product offers, pricing tables, and consultant material.',
    href: '/portal/sheets/',
    allowed: access.isInternal,
    label: 'Internal roles only',
  },
  {
    title: 'User management',
    description: 'Invite users, assign roles, disable access, and remove accounts.',
    href: '/portal/admin/users/',
    allowed: access.isAdmin,
    label: 'Superadmin only',
  },
];
---
<PortalLayout title={title} description={description} tenant={tenant} signedIn={Boolean(user)} access={access}>
  <section class="mx-auto w-[min(1240px,92vw)] py-10 lg:py-14">
    <div class="rounded-[2rem] border border-[color:var(--color-fog)] bg-[#111927] p-8 text-paper shadow-[0_30px_90px_rgba(0,0,0,0.2)] md:p-10">
      <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[#14B8A6]">
        Account
      </div>
      <div class="mt-5 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <h1 class="font-display text-[clamp(2.4rem,4vw,4.7rem)] font-semibold leading-[0.98] tracking-tight">
            Your portal profile.
          </h1>
        </div>
        <div>
          <p class="max-w-2xl text-lg leading-relaxed text-paper/72 md:text-xl">
            See the account you are signed in with, the roles assigned to you, and which Advanced Analytica portal areas those roles unlock.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-paper/52">
            Access is read-only here. A superadmin can change roles from user management.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[0.82fr_1.18fr]">
      <aside class="rounded-[2rem] border border-[#d7dde5] bg-white p-6 text-slate-950 shadow-[0_24px_70px_rgba(15,23,42,0.08)] md:p-8">
        <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[#14B8A6]">
          Signed in as
        </div>
        <h2 class="mt-3 break-words text-3xl font-semibold tracking-tight">
          {user?.email}
        </h2>

        <dl class="mt-7 grid gap-4 text-sm">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <dt class="font-semibold uppercase tracking-[0.12em] text-slate-400">Tenant</dt>
            <dd class="mt-2 text-base text-slate-800">{tenant.name}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <dt class="font-semibold uppercase tracking-[0.12em] text-slate-400">Audience</dt>
            <dd class="mt-2 text-base text-slate-800">{access.audienceLabel}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <dt class="font-semibold uppercase tracking-[0.12em] text-slate-400">Last sign-in</dt>
            <dd class="mt-2 text-base text-slate-800">{formatDate(user?.last_sign_in_at)}</dd>
          </div>
        </dl>
      </aside>

      <div class="grid gap-8">
        <section class="rounded-[2rem] border border-[#d7dde5] bg-white p-6 text-slate-950 shadow-[0_24px_70px_rgba(15,23,42,0.08)] md:p-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[#14B8A6]">
                Roles
              </div>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight">What your account can do.</h2>
            </div>
            <a
              href="/portal"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-slate-700 transition hover:border-[#14B8A6]"
            >
              Portal Home
            </a>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            {roleLabels.map((role) => (
              <span class="rounded-full border border-[#14B8A6]/30 bg-[#14B8A6]/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#0f766e]">
                {role}
              </span>
            ))}
          </div>

          <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-600">
            Client accounts can access provisioned service workflows. Internal roles can also open the Offer Builder. Superadmins can manage users and roles.
          </p>
        </section>

        <section class="overflow-hidden rounded-[2rem] border border-[#d7dde5] bg-white text-slate-950 shadow-[0_24px_70px_rgba(15,23,42,0.08)]">
          <div class="border-b border-slate-200 px-6 py-5 md:px-8">
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-[#14B8A6]">
              Access
            </div>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight">Available portal areas.</h2>
          </div>

          <div class="divide-y divide-slate-200">
            {portalAreas.map((area) => (
              <div class="grid gap-4 px-6 py-5 md:px-8 lg:grid-cols-[1fr_auto] lg:items-center">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="text-xl font-semibold tracking-tight">{area.title}</h3>
                    <span class={area.allowed
                      ? 'rounded-full bg-[#14B8A6]/12 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-[#0f766e]'
                      : 'rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-slate-500'}
                    >
                      {area.allowed ? 'Enabled' : 'Locked'}
                    </span>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{area.description}</p>
                  <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">{area.label}</p>
                </div>
                {area.allowed ? (
                  <a
                    href={area.href}
                    class="inline-flex items-center justify-center rounded-md bg-[#14B8A6] px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-white transition hover:bg-[#0f9288]"
                  >
                    Open
                  </a>
                ) : (
                  <span class="inline-flex items-center justify-center rounded-md border border-slate-200 px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-slate-400">
                    No Access
                  </span>
                )}
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</PortalLayout>
