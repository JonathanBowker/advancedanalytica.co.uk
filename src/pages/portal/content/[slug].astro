---
import { getCollection } from 'astro:content';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import components from '../../../lib/mdx/components';
import { getPortalAccess } from '../../../lib/portalAccess';
import { canAccessPortalContent, getPortalContentAccessLabel } from '../../../lib/portalContent';

export const prerender = false;

const tenant = Astro.locals.tenant;
const user = Astro.locals.user;
const access = getPortalAccess(user);

const items = await getCollection('portalContent', ({ data }) => !data.draft);
const item = items.find((entry) => entry.slug === Astro.params.slug);

if (!item) {
  return Astro.redirect('/portal/content/');
}

if (!canAccessPortalContent(item.data.access, access)) {
  return Astro.redirect('/portal/content/');
}

const { Content } = await item.render();
const related = items
  .filter((entry) => entry.slug !== item.slug)
  .filter((entry) => canAccessPortalContent(entry.data.access, access))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
  .slice(0, 3);

const title = `${item.data.title} | ${tenant.name}`;
const description = item.data.description;
---
<PortalLayout title={title} description={description} tenant={tenant} signedIn={Boolean(user)} access={access}>
  <section class="mx-auto w-[min(1352px,calc(100vw-3rem))] py-10 lg:py-12">
    <a
      href="/portal/content/"
      class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.18em] uppercase text-[#5f6368] transition hover:text-[#202123]"
    >
      <span class="text-2xl leading-none">←</span>
      Back to content
    </a>

    <section class="mt-8 overflow-hidden rounded-[1.75rem] border border-[#e2e2e2] bg-white">
      <div class="grid lg:grid-cols-[0.95fr_1.05fr]">
        <div class="border-b border-[#e7eaef] p-8 lg:border-b-0 lg:border-r lg:p-10">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex rounded-full bg-[#14B8A6]/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.12em] text-[#0f766e]">
              {item.data.format}
            </span>
            <span class="inline-flex rounded-full bg-[#eceff3] px-3 py-1 text-xs font-medium uppercase tracking-[0.12em] text-[#5f6368]">
              {getPortalContentAccessLabel(item.data.access)}
            </span>
          </div>
          <h1 class="mt-5 max-w-[12ch] text-[clamp(2.2rem,4.5vw,4.25rem)] font-medium leading-[0.98] tracking-[-0.05em] text-[#111]">
            {item.data.title}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-7 text-[#5f6368]">
            {item.data.description}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {item.data.downloadUrl ? (
              <a
                href={item.data.downloadUrl}
                class="inline-flex items-center justify-center rounded-md bg-[#171717] px-4 py-2.5 text-xs font-bold uppercase tracking-[0.08em] text-white transition hover:bg-[#2a2a2a]"
              >
                Download asset
              </a>
            ) : null}
            <a
              href="/portal/products/"
              class="inline-flex items-center justify-center rounded-md border border-[#d6d6d6] bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-[0.08em] text-[#202123] transition hover:border-[#14B8A6] hover:text-[#0f766e]"
            >
              View products
            </a>
          </div>
        </div>

        <div class="bg-[radial-gradient(circle_at_20%_35%,rgba(20,184,166,0.14),transparent_34%),linear-gradient(140deg,#fbfbfc_0%,#f2f6fb_52%,#eef8f5_100%)] p-8 lg:p-10">
          <div class="text-xs font-medium uppercase tracking-[0.16em] text-[#0f9288]">Share this page</div>
          <h2 class="mt-3 text-2xl font-medium tracking-[-0.03em] text-[#111]">
            Send the protected link directly.
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-[#5f6368]">
            If the recipient is not signed in, the portal will send them through secure-code login first and return them to this exact page afterward. No separate sign-in flow is required on the content page itself.
          </p>
          <div class="mt-8 rounded-2xl border border-white/70 bg-white/85 p-5 shadow-[0_18px_50px_rgba(15,23,42,0.08)]">
            <div class="text-[11px] font-medium uppercase tracking-[0.14em] text-[#0f9288]">Direct URL</div>
            <div class="mt-2 break-all text-sm leading-6 text-[#202123]">
              {Astro.url.href}
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="mt-10 grid gap-10 xl:grid-cols-[1.25fr_0.75fr]">
      <article class="rounded-[1.5rem] border border-[#e2e2e2] bg-white p-8 lg:p-10">
        <div class="prose max-w-none prose-headings:text-[#111] prose-headings:tracking-[-0.03em] prose-p:text-[#4b5563] prose-p:leading-7 prose-li:text-[#4b5563] prose-strong:text-[#202123]">
          <Content components={components} />
        </div>
      </article>

      <aside class="grid content-start gap-4">
        {related.length ? (
          <section class="rounded-[1.5rem] border border-[#e2e2e2] bg-white p-5">
            <div class="text-xs font-medium uppercase tracking-[0.12em] text-[#0f9288]">Related content</div>
            <div class="mt-4 space-y-3">
              {related.map((entry) => (
                <a
                  href={`/portal/content/${entry.slug}/`}
                  class="group block rounded-xl border border-[#edf0f3] px-4 py-4 transition hover:bg-[#f7f7f7]"
                >
                  <div class="text-[11px] font-medium uppercase tracking-[0.14em] text-[#0f9288]">{entry.data.format}</div>
                  <h3 class="mt-1 text-sm font-medium text-[#202123]">{entry.data.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-[#5f6368]">{entry.data.summary}</p>
                  <div class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-[#202123]">
                    {entry.data.ctaLabel}
                    <span class="transition-transform duration-200 group-hover:translate-x-1">›</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ) : null}

        <a
          href="/portal/account/"
          class="group rounded-[1.5rem] border border-[#e2e2e2] bg-white p-5 transition hover:bg-[#f7f7f7]"
        >
          <div class="text-xs font-medium uppercase tracking-[0.12em] text-[#0f9288]">Account</div>
          <h2 class="mt-2 text-lg font-medium tracking-[-0.02em] text-[#202123]">Profile and access</h2>
          <p class="mt-3 text-sm leading-6 text-[#5f6368]">
            Check what portal areas your account can open and what protected content you can share.
          </p>
        </a>
      </aside>
    </div>
  </section>
</PortalLayout>
