---
const briefUrl = "https://advancedanalytica.co.uk/agents/advanced-analytica.md";
const prompt = `Read from ${briefUrl} and follow the brief so I can ask questions about Advanced Analytica.`;
const encodedPrompt = encodeURIComponent(prompt);
const claudeUrl = `https://claude.ai/new?q=${encodedPrompt}`;
const chatGptUrl = `https://chatgpt.com/?hint=search&q=${encodedPrompt}`;
const perplexityUrl = `https://www.perplexity.ai/search/new?q=${encodedPrompt}`;
const {
  label = "YOUR AGENT",
  action = "copy",
  variant = "outline",
} = Astro.props;
---

<div
  class="agent-brief"
  data-agent-brief
  data-agent-brief-action={action}
  data-copy-prompt={prompt}
>
  <div class:list={["agent-brief__control", variant === "primary" && "agent-brief__control--primary"]}>
    <button class="agent-brief__copy" type="button" data-agent-brief-copy>
      <span data-agent-brief-label data-default-label={label}>{label}</span>
    </button>

    <details class="agent-brief__details">
      <summary aria-label="More agent onboarding options">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <div class="agent-brief__menu">
        <a href={claudeUrl} target="_blank" rel="noreferrer">
          <img src="/images/logos/claude.svg" alt="" />
          <span>CLAUDE</span><span aria-hidden="true">↗</span>
        </a>
        <a href={chatGptUrl} target="_blank" rel="noreferrer">
          <img src="/images/logos/openai.svg" alt="" />
          <span>GPT</span><span aria-hidden="true">↗</span>
        </a>
        <a href={perplexityUrl} target="_blank" rel="noreferrer">
          <svg class="agent-brief__perplexity-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.398 7.09h-2.31V.068l-7.51 6.354V.158h-1.156v6.196L4.49 0v7.09H1.602v10.397H4.49V24l6.933-6.36v6.201h1.155v-6.047l6.932 6.181v-6.488h2.888zm-3.466-4.531v4.53h-5.355zm-13.286.067l4.869 4.464h-4.87zM2.758 16.332V8.245h7.847L4.49 14.36v1.972zm2.888 5.04v-6.534l5.776-5.776v7.011zm12.708.025l-5.776-5.15V9.061l5.776 5.776zm2.889-5.065H19.51V14.36l-6.115-6.115h7.848z" />
          </svg>
          <span>PERPLEXITY</span><span aria-hidden="true">↗</span>
        </a>
        <div class="agent-brief__divider"></div>
        <a href="/agents/advanced-analytica.md" target="_blank" rel="noreferrer">
          <span>VIEW MD</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </details>
  </div>
  <span class="agent-brief__status" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll("[data-agent-brief]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    const button = element.querySelector("[data-agent-brief-copy]");
    const label = element.querySelector("[data-agent-brief-label]");
    const status = element.querySelector(".agent-brief__status");
    if (!(button instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) return;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(element.dataset.copyPrompt || "");
        label.textContent = "PROMPT COPIED";
        if (status) status.textContent = "Agent prompt copied to clipboard.";
        window.setTimeout(() => {
          label.textContent = label.dataset.defaultLabel || "YOUR AGENT";
          if (status) status.textContent = "";
        }, 1800);
      } catch {
        window.location.href = "/agents/advanced-analytica.md";
      }
    });
  });
</script>

<style>
  .agent-brief { position: relative; display: inline-flex; flex-direction: column; align-items: flex-start; }
  .agent-brief__control {
    display: flex; min-height: 3.5rem; align-items: stretch; overflow: visible;
    border: 1.5px solid #14b8a6; border-radius: 0.875rem; background: transparent; color: #0f766e;
  }
  .agent-brief__control--primary {
    border-color: #14b8a6; background: #14b8a6; color: #ffffff;
  }
  .agent-brief__control--primary .agent-brief__details { border-left-color: rgba(255,255,255,.32); }
  .agent-brief__control--primary .agent-brief__copy:hover,
  .agent-brief__control--primary .agent-brief__details summary:hover { background: #0f766e; }
  .agent-brief__copy, .agent-brief__details summary {
    border: 0; background: transparent; color: inherit; cursor: pointer;
  }
  .agent-brief__copy {
    display: flex; align-items: center; gap: 0.65rem; padding: 0.85rem 1rem 0.85rem 1.15rem;
    border-radius: calc(0.875rem - 1.5px) 0 0 calc(0.875rem - 1.5px);
    font-family: var(--font-display); font-size: 0.875rem; font-weight: 700;
    letter-spacing: 0.02em; white-space: nowrap;
  }
  .agent-brief__menu img, .agent-brief__menu svg {
    width: 1rem; height: 1rem; flex: 0 0 auto; object-fit: contain;
  }
  .agent-brief__perplexity-mark { color: #6b7280; fill: currentColor; }
  .agent-brief__details { position: relative; display: flex; border-left: 1px solid rgba(11,18,32,.15); }
  .agent-brief__details summary {
    display: grid; width: 3.25rem; height: 100%; min-height: 3.5rem;
    border-radius: 0 calc(0.875rem - 1.5px) calc(0.875rem - 1.5px) 0;
    list-style: none; place-items: center;
  }
  .agent-brief__details summary::-webkit-details-marker { display: none; }
  .agent-brief__details summary svg {
    width: .9rem; height: .9rem; fill: none; stroke: currentColor; stroke-linecap: round;
    stroke-linejoin: round; stroke-width: 2; transition: transform 180ms ease;
  }
  .agent-brief__details[open] summary svg { transform: rotate(180deg); }
  .agent-brief__copy:hover, .agent-brief__details summary:hover { background: rgba(20,184,166,.08); }
  .agent-brief__menu {
    position: absolute; z-index: 30; top: calc(100% + .65rem); right: 0;
    width: min(19rem, calc(100vw - 2.5rem)); overflow: hidden;
    border: 1px solid rgba(11,18,32,.12); border-radius: 1rem; background: #fff;
    box-shadow: 0 20px 55px rgba(11,18,32,.18);
  }
  .agent-brief__menu a {
    display: grid; grid-template-columns: 1.25rem 1fr auto; align-items: center;
    gap: .75rem; padding: .9rem 1rem; color: #0b1220; font-size: .875rem;
    font-weight: 650; text-decoration: none;
  }
  .agent-brief__menu a:last-child { grid-template-columns: 1fr auto; }
  .agent-brief__menu a:hover { background: #eef2f5; color: #0f766e; }
  .agent-brief__divider { height: 1px; margin: .25rem 0; background: rgba(11,18,32,.1); }
  .agent-brief__status {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  @media (max-width: 520px) {
    .agent-brief, .agent-brief__control { width: 100%; }
    .agent-brief__copy {
      min-width: 0; flex: 1; justify-content: center; padding-inline: .75rem; font-size: .78rem;
    }
  }
</style>
