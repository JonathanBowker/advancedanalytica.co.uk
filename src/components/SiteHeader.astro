---
const { contactHref = "/company/contact/", signedIn = false } = Astro.props;
const authHref = signedIn ? '/logout' : '/login';
const authLabel = signedIn ? 'Sign out' : 'Sign in';
type NavItem = {
  label: string;
  href: string;
  registered?: 'brando' | 'ibom-framework' | 'ibom-way';
  children?: { label: string; href: string; group?: string; registered?: 'brando' | 'ibom-framework' | 'ibom-way' }[];
};

const nav: NavItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Case Studies',
    href: '/case-studies',
    children: [
      { label: 'Brand Governance', href: '/case-studies/#brand-governance', group: 'Categories' },
      { label: 'Risk and Compliance', href: '/case-studies/#risk-and-compliance', group: 'Categories' },
      {
        label: 'Emissions and Natural Capital',
        href: '/case-studies/#emissions-and-natural-capital',
        group: 'Categories'
      },
      { label: 'Estates and Land', href: '/case-studies/#estates-and-land', group: 'More Categories' },
      { label: 'Creative and Production', href: '/case-studies/#creative-and-production', group: 'More Categories' },
      { label: 'Health and Care', href: '/case-studies/#health-and-care', group: 'More Categories' },
      { label: 'View all case studies', href: '/case-studies/', group: 'Explore' },
    ]
  },
  {
    label: 'Opinions',
    href: '/opinions',
    children: [
      { label: 'AI Agents', href: '/opinions/series/AI Agents/', group: 'By Series' },
      { label: 'AI Brand Governance', href: '/opinions/series/AI Brand Governance/', group: 'By Series' },
      { label: 'Brand-as-Code', href: '/opinions/series/Brand-as-Code/', group: 'By Series' },
      { label: 'Machine-Readable Brand Policy', href: '/opinions/series/Machine-Readable Brand Policy/', group: 'By Series' },
      { label: 'The Tokenised Brand', href: '/opinions/series/The Tokenised Brand/', group: 'By Series' },
      { label: 'Governance', href: '/opinions/tag/Governance/', group: 'Key Topics' },
      { label: 'Policy', href: '/opinions/tag/Policy/', group: 'Key Topics' },
      { label: 'MCP', href: '/opinions/tag/MCP/', group: 'Key Topics' },
      { label: 'Operating Model', href: '/opinions/tag/Operating Model/', group: 'Key Topics' },
      { label: 'View all opinions', href: '/opinions/', group: 'Explore' },
    ]
  },
  { label: 'Resources', href: '/resources' },
  { label: 'About', href: '/company/about' }
];
---
 <header data-site-header class="fixed top-0 z-50 w-full border-b border-white/15 bg-[#050505]/94 text-white backdrop-blur transition-colors duration-300">
  <div class="container-nav flex items-center justify-between py-4 md:py-4.5">
    <a href="/" data-header-logo-link class="flex items-center gap-3 text-white/80 justify-self-start transition-colors hover:text-white">
      <img
        src="/images/infrastructure/logo.svg"
        alt="Advanced Analytica"
        data-header-logo
        class="h-7 w-auto brightness-0 invert saturate-100 transition-[filter] duration-300 md:h-9"
        decoding="async"
      />
      <span class="sr-only">Advanced Analytica: IBOM</span>
    </a>
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={authHref}
        data-header-auth-link
        class="inline-flex items-center gap-2 rounded-md border border-white/20 bg-white/[0.08] px-3 py-2 text-xs font-semibold text-white/82 transition-colors hover:border-[#14B8A6]/55 hover:bg-[#14B8A6]/[0.14] hover:text-white"
      >
        {authLabel}
      </a>
      <a
        href={contactHref}
        data-header-contact-link
        class="inline-flex items-center gap-2 rounded-md bg-[#14B8A6] px-3 py-2 text-xs font-semibold text-paper transition-colors hover:bg-[#0F766E]"
      >
        TALK TO US
        <svg
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h12" />
          <path d="M12 6l4 4-4 4" />
        </svg>
      </a>
      <button
        type="button"
        data-mobile-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-white/20 bg-white/[0.08] text-white/78 transition-colors hover:border-white/35 hover:text-white"
      >
        <svg
          data-mobile-menu-icon-open
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h14"></path>
          <path d="M3 10h14"></path>
          <path d="M3 14h14"></path>
        </svg>
        <svg
          data-mobile-menu-icon-close
          class="hidden h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 5l10 10"></path>
          <path d="M15 5L5 15"></path>
        </svg>
      </button>
    </div>
    <div class="hidden md:flex md:flex-1 md:items-center md:justify-end md:gap-7">
      <div class="relative flex flex-1 items-center justify-end gap-7">
        <nav data-main-nav class="flex items-center gap-9 text-[0.96rem] text-white/78 transition-opacity duration-200">
          {nav.map((item) =>
            item.children ? (
              <div class="relative group after:absolute after:inset-x-0 after:top-full after:h-4 after:content-[''] after:bg-transparent">
                <a
                  href={item.href}
                  class="inline-flex items-center gap-2 hover:text-white transition-colors"
                  aria-haspopup="true"
                >
                  {item.registered === 'brando' ? (
                    <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                  ) : item.label}
                  <svg
                    class="h-4 w-4 opacity-45 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M5.75 7.75L10 12l4.25-4.25" />
                  </svg>
                </a>

                <div
                  class:list={[
                    "absolute left-1/2 top-full z-50 mt-2 -translate-x-1/2 translate-y-2 scale-[0.98] opacity-0 pointer-events-none transition-all duration-200 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto",
                    item.label === 'Case Studies' || item.label === 'Opinions' ? "w-[560px]" : "w-[320px]",
                  ]}
                >
                  <div class="rounded-xl border border-[#e7e0d4] bg-white p-3 shadow-outline">
                    {item.label === 'Case Studies' || item.label === 'Opinions' ? (
                      <div class="grid gap-3 md:grid-cols-[1fr_1fr]">
                        {(item.label === 'Case Studies'
                          ? ['Categories', 'More Categories']
                          : ['By Series', 'Key Topics']
                        ).map((group) => (
                          <div>
                            <div class="px-4 pb-2 pt-2 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-[#14B8A6]">
                              {group}
                            </div>
                            <div class="grid">
                              {item.children!
                                .filter((child) => child.group === group)
                                .map((child) => (
                                  <a
                                    href={child.href}
                                    class="rounded-lg px-4 py-3 text-sm font-semibold text-ink/88 transition-colors hover:bg-[#f5f1e8] hover:text-ink"
                                  >
                                    {child.registered === 'brando' ? (
                                      <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                                    ) : child.registered === 'ibom-framework' ? (
                                      <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                                    ) : child.registered === 'ibom-way' ? (
                                      <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                                    ) : child.label}
                                  </a>
                                ))}
                            </div>
                          </div>
                        ))}
                        <div class="md:col-span-2">
                          {item.children!
                            .filter((child) => child.group === 'Explore')
                            .map((child) => (
                              <a
                                href={child.href}
                                class="mt-1 flex items-center justify-between rounded-lg border border-[#d7efe9] bg-[#f0fbf8] px-4 py-3 text-sm font-bold text-[#0F766E] transition-colors hover:border-[#14B8A6] hover:bg-[#e4f8f3]"
                              >
                                <span>
                                  {child.registered === 'brando' ? (
                                    <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                                  ) : child.registered === 'ibom-framework' ? (
                                    <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                                  ) : child.registered === 'ibom-way' ? (
                                    <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                                  ) : child.label}
                                </span>
                                <span aria-hidden="true">→</span>
                              </a>
                            ))}
                        </div>
                      </div>
                    ) : (
                      <div class="grid">
                        {item.children.map((child) => (
                          <a
                            href={child.href}
                            class="rounded-lg px-5 py-4 text-sm font-semibold text-ink/88 hover:bg-[#f5f1e8] hover:text-ink transition-colors"
                          >
                            {child.registered === 'brando' ? (
                              <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                            ) : child.registered === 'ibom-framework' ? (
                              <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                            ) : child.registered === 'ibom-way' ? (
                              <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                            ) : child.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class="inline-flex items-center hover:text-white transition-colors">
                {item.registered === 'brando' ? (
                  <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                ) : item.label}
              </a>
            )
          )}
        </nav>
        <button
          type="button"
          data-search-toggle
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="site-search-panel"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-white/20 bg-white/[0.08] text-white/78 transition-colors hover:border-white/35 hover:text-white"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="9" r="5"></circle>
            <path d="M13 13l4 4"></path>
          </svg>
        </button>
        <div
          id="site-search-panel"
          data-search-panel
          class="absolute inset-y-[-0.2rem] right-0 flex w-full max-w-[48rem] items-center opacity-0 pointer-events-none -translate-x-8 transition-all duration-300 ease-out"
        >
          <form action="/search" method="get" class="w-full">
            <label class="sr-only" for="site-search-input">Search</label>
            <div class="relative">
              <input
                id="site-search-input"
                name="q"
                type="search"
                placeholder="Search the site..."
                class="w-full rounded-md border border-[#e7e0d4] bg-white px-4 py-3 pr-24 text-base text-ink placeholder:text-ink/35 focus:outline-none focus:ring-2 focus:ring-[#14B8A6]/30"
              />
              <button
                type="submit"
                aria-label="Submit search"
                class="absolute right-11 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-ink/52 transition-colors hover:text-ink"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="9" cy="9" r="5"></circle>
                  <path d="M13 13l4 4"></path>
                </svg>
              </button>
              <button
                type="button"
                data-search-close
                aria-label="Close search"
                class="absolute right-3 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-ink/52 transition-colors hover:text-ink"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 5l10 10"></path>
                  <path d="M15 5L5 15"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
      <a
        href={authHref}
        data-header-auth-link
        class="inline-flex items-center gap-2 rounded-md border border-white/20 bg-white/[0.08] px-5 py-2.5 text-sm font-medium text-white/82 transition-colors hover:border-[#14B8A6]/55 hover:bg-[#14B8A6]/[0.14] hover:text-white"
      >
        {authLabel}
        
      </a>
      <a
        href={contactHref}
        data-header-contact-link
        class="inline-flex items-center gap-2 rounded-md bg-[#14B8A6] px-5 py-2.5 text-sm font-semibold text-paper hover:bg-[#0F766E] transition-colors"
      >
        TALK TO US
        
      </a>
    </div>
  </div>
  <div
    id="mobile-nav-panel"
    data-mobile-menu-panel
    class="hidden border-t border-white/15 bg-[#050505] md:hidden"
  >
    <nav class="container-nav grid gap-1 py-4 text-base font-medium text-white/78" aria-label="Mobile navigation">
      {nav.map((item) => (
        <>
          <a
            href={item.href}
            class="rounded-md px-3 py-3 transition-colors hover:bg-white/[0.08] hover:text-white"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="-mt-1 grid gap-1 border-l border-[#14B8A6]/35 pl-4">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="rounded-md px-3 py-2 text-sm text-white/62 transition-colors hover:bg-white/[0.08] hover:text-white"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
      <a
        href="/search"
        class="rounded-md px-3 py-3 transition-colors hover:bg-white/[0.08] hover:text-white"
      >
        Search
      </a>
    </nav>
  </div>
</header>
<style>
  [data-site-header][data-scrolled="true"] {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(5, 5, 5, 0.94);
    color: #ffffff;
  }

  [data-site-header][data-scrolled="true"] [data-header-logo-link],
  [data-site-header][data-scrolled="true"] [data-main-nav] > a,
  [data-site-header][data-scrolled="true"] [data-main-nav] > div > a {
    color: rgba(255, 255, 255, 0.78);
  }

  [data-site-header][data-scrolled="true"] [data-header-logo-link]:hover,
  [data-site-header][data-scrolled="true"] [data-main-nav] > a:hover,
  [data-site-header][data-scrolled="true"] [data-main-nav] > div > a:hover {
    color: #ffffff;
  }

  [data-site-header][data-scrolled="true"] [data-header-logo] {
    filter: brightness(0) invert(1);
  }

  [data-site-header][data-scrolled="true"] [data-search-toggle],
  [data-site-header][data-scrolled="true"] [data-mobile-menu-toggle] {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
  }

  [data-site-header][data-scrolled="true"] [data-search-toggle]:hover,
  [data-site-header][data-scrolled="true"] [data-mobile-menu-toggle]:hover {
    border-color: rgba(255, 255, 255, 0.34);
    color: #ffffff;
  }

  [data-site-header][data-scrolled="true"] [data-header-auth-link] {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
  }

  [data-site-header][data-scrolled="true"] [data-header-auth-link]:hover {
    border-color: rgba(20, 184, 166, 0.55);
    background: rgba(20, 184, 166, 0.14);
    color: #ffffff;
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] {
    border-color: rgba(255, 255, 255, 0.14);
    background: #050505;
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > a {
    color: rgba(255, 255, 255, 0.78);
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > div {
    border-color: rgba(20, 184, 166, 0.35);
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > div p,
  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > div a {
    color: rgba(255, 255, 255, 0.62);
  }

  [data-site-header][data-scrolled="true"] [data-mobile-menu-panel] nav > div a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }
</style>
<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    let ticking = false;

    const setScrolled = () => {
      header.dataset.scrolled = window.scrollY > 16 ? 'true' : 'false';
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(setScrolled);
    };

    setScrolled();
    window.addEventListener('scroll', requestUpdate, { passive: true });
  })();

  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    const toggle = header.querySelector('[data-search-toggle]');
    const panel = header.querySelector('[data-search-panel]');
    const input = header.querySelector('#site-search-input');
    const close = header.querySelector('[data-search-close]');
    const nav = header.querySelector('[data-main-nav]');

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(panel instanceof HTMLElement)) return;
    if (!(input instanceof HTMLInputElement)) return;
    if (!(close instanceof HTMLButtonElement)) return;

    const setOpen = (open) => {
      nav?.classList.toggle('opacity-0', open);
      nav?.classList.toggle('pointer-events-none', open);
      panel.classList.toggle('opacity-0', !open);
      panel.classList.toggle('-translate-x-8', !open);
      panel.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('opacity-100', open);
      panel.classList.toggle('translate-x-0', open);
      panel.classList.toggle('pointer-events-auto', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close search' : 'Open search');
      if (open) window.requestAnimationFrame(() => input.focus());
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    close.addEventListener('click', () => setOpen(false));

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();

  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    const toggle = header.querySelector('[data-mobile-menu-toggle]');
    const panel = header.querySelector('[data-mobile-menu-panel]');
    const openIcon = header.querySelector('[data-mobile-menu-icon-open]');
    const closeIcon = header.querySelector('[data-mobile-menu-icon-close]');

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(panel instanceof HTMLElement)) return;
    if (!(openIcon instanceof SVGElement)) return;
    if (!(closeIcon instanceof SVGElement)) return;

    const setOpen = (open) => {
      panel.classList.toggle('hidden', !open);
      openIcon.classList.toggle('hidden', open);
      closeIcon.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
    });
  })();
</script>
