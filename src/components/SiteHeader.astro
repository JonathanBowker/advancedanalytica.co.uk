---
const { contactHref = "/company/contact/", signedIn = false } = Astro.props;
const authHref = signedIn ? '/logout' : '/login';
const authLabel = signedIn ? 'Sign out' : 'Sign in';
type NavItem = {
  label: string;
  href: string;
  registered?: 'brando' | 'ibom-framework' | 'ibom-way';
  children?: { label: string; href: string; group?: string; registered?: 'brando' | 'ibom-framework' | 'ibom-way' }[];
};

const nav: NavItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Products',
    href: '/brando/',
    children: [
      { label: 'Brando', href: '/brando/', group: 'Product', registered: 'brando' },
      { label: 'Content Atomiser', href: '/atomiser/', group: 'Product' },
      { label: 'How It Works', href: '/how-it-works/', group: 'Product' },
      { label: 'For Leaders', href: '/for-leaders/', group: 'Product' },
      { label: 'AI Knowledge Packs', href: '/services/ai-ready-knowledge-packs/', group: 'Framework' },
      { label: 'IBOM Framework', href: '/ibom/', group: 'Framework', registered: 'ibom-framework' },
      { label: 'The IBOM Way', href: '/ibom-way/', group: 'Framework', registered: 'ibom-way' },
      { label: 'AI Drift Audit', href: '/brand-ai-drift-audit/', group: 'Framework' },
      { label: 'Book a Conversation', href: '/company/contact/', group: 'Explore' },
    ]
  },
  {
    label: 'Use Cases',
    href: '/use-cases',
    children: [
      { label: 'Brand & Marketing', href: '/functions/brand-marketing/', group: 'By Function' },
      { label: 'Legal, Risk & Compliance', href: '/functions/legal-risk-compliance/', group: 'By Function' },
      { label: 'Product & Engineering', href: '/functions/product-engineering/', group: 'By Function' },
      { label: 'Leadership', href: '/functions/leadership/', group: 'By Function' },
      { label: 'Sales, Operations & Service', href: '/functions/sales-operations-service/', group: 'By Function' },
      { label: 'AI brand governance', href: '/use-cases/tag/Governance/', group: 'Common Problems' },
      { label: 'Approval bottlenecks', href: '/use-cases/tag/Approvals/', group: 'Common Problems' },
      { label: 'Policy control', href: '/use-cases/tag/Policy/', group: 'Common Problems' },
      { label: 'MCP and agent guardrails', href: '/use-cases/tag/MCP/', group: 'Common Problems' },
      { label: 'View all use cases', href: '/use-cases/', group: 'Explore' },
    ]
  },
  {
    label: 'Opinions',
    href: '/opinions',
    children: [
      { label: 'AI Agents', href: '/opinions/series/AI Agents/', group: 'By Series' },
      { label: 'AI Brand Governance', href: '/opinions/series/AI Brand Governance/', group: 'By Series' },
      { label: 'Brand-as-Code', href: '/opinions/series/Brand-as-Code/', group: 'By Series' },
      { label: 'Machine-Readable Brand Policy', href: '/opinions/series/Machine-Readable Brand Policy/', group: 'By Series' },
      { label: 'The Tokenised Brand', href: '/opinions/series/The Tokenised Brand/', group: 'By Series' },
      { label: 'Governance', href: '/opinions/tag/Governance/', group: 'Key Topics' },
      { label: 'Policy', href: '/opinions/tag/Policy/', group: 'Key Topics' },
      { label: 'MCP', href: '/opinions/tag/MCP/', group: 'Key Topics' },
      { label: 'Operating Model', href: '/opinions/tag/Operating Model/', group: 'Key Topics' },
      { label: 'View all opinions', href: '/opinions/', group: 'Explore' },
    ]
  },
  { label: 'Resources', href: '/resources' },
  { label: 'About', href: '/company/about' }
];
---
 <header data-site-header class="fixed top-0 z-50 w-full border-b border-[#e7e0d4] bg-[#fbfaf6]/96 text-ink backdrop-blur">
  <div class="container-nav flex items-center justify-between py-4 md:py-4.5">
    <a href="/" class="flex items-center gap-3 text-ink justify-self-start">
      <img
        src="/images/infrastructure/logo.svg"
        alt="Advanced Analytica"
        class="h-7 w-auto brightness-0 saturate-100 md:h-9"
        decoding="async"
      />
      <span class="sr-only">Advanced Analytica: IBOM</span>
    </a>
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={authHref}
        class="inline-flex items-center gap-2 rounded-md border border-[#cfe8e2] bg-white px-3 py-2 text-xs font-semibold text-[#0F766E] transition-colors hover:border-[#14B8A6] hover:bg-[#f0fbf8]"
      >
        {authLabel}
      </a>
      <a
        href={contactHref}
        class="inline-flex items-center gap-2 rounded-md bg-[#14B8A6] px-3 py-2 text-xs font-semibold text-paper transition-colors hover:bg-[#0F766E]"
      >
        Talk to Us
        <svg
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h12" />
          <path d="M12 6l4 4-4 4" />
        </svg>
      </a>
      <button
        type="button"
        data-mobile-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[#e7e0d4] bg-white text-ink/72 transition-colors hover:border-[#cfc4b1] hover:text-ink"
      >
        <svg
          data-mobile-menu-icon-open
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h14"></path>
          <path d="M3 10h14"></path>
          <path d="M3 14h14"></path>
        </svg>
        <svg
          data-mobile-menu-icon-close
          class="hidden h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 5l10 10"></path>
          <path d="M15 5L5 15"></path>
        </svg>
      </button>
    </div>
    <div class="hidden md:flex md:flex-1 md:items-center md:justify-end md:gap-7">
      <div class="relative flex flex-1 items-center justify-end gap-7">
        <nav data-main-nav class="flex items-center gap-9 text-[0.96rem] text-ink/72 transition-opacity duration-200">
          {nav.map((item) =>
            item.children ? (
              <div class="relative group after:absolute after:inset-x-0 after:top-full after:h-4 after:content-[''] after:bg-transparent">
                <a
                  href={item.href}
                  class="inline-flex items-center gap-2 hover:text-ink transition-colors"
                  aria-haspopup="true"
                >
                  {item.registered === 'brando' ? (
                    <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                  ) : item.label}
                  <svg
                    class="h-4 w-4 opacity-45 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M5.75 7.75L10 12l4.25-4.25" />
                  </svg>
                </a>

                <div
                  class:list={[
                    "absolute left-1/2 top-full z-50 mt-2 -translate-x-1/2 translate-y-2 scale-[0.98] opacity-0 pointer-events-none transition-all duration-200 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto",
                    item.label === 'Products' || item.label === 'Use Cases' || item.label === 'Opinions' ? "w-[560px]" : "w-[320px]",
                  ]}
                >
                  <div class="rounded-xl border border-[#e7e0d4] bg-white p-3 shadow-outline">
                    {item.label === 'Products' || item.label === 'Use Cases' || item.label === 'Opinions' ? (
                      <div class="grid gap-3 md:grid-cols-[1fr_1fr]">
                        {item.label === 'Products' ? (
                          <div class="md:col-span-2 px-4 pb-1 pt-2 text-sm leading-relaxed text-ink/62">
                            Atomise your brand, build a knowledge pack, test the value, then build and deploy your agent.
                          </div>
                        ) : null}
                        {(item.label === 'Products'
                          ? ['Product', 'Framework']
                          : item.label === 'Use Cases'
                            ? ['By Function', 'Common Problems']
                            : ['By Series', 'Key Topics']
                        ).map((group) => (
                          <div>
                            <div class="px-4 pb-2 pt-2 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-[#14B8A6]">
                              {group}
                            </div>
                            <div class="grid">
                              {item.children
                                .filter((child) => child.group === group)
                                .map((child) => (
                                  <a
                                    href={child.href}
                                    class="rounded-lg px-4 py-3 text-sm font-semibold text-ink/88 transition-colors hover:bg-[#f5f1e8] hover:text-ink"
                                  >
                                    {child.registered === 'brando' ? (
                                      <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                                    ) : child.registered === 'ibom-framework' ? (
                                      <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                                    ) : child.registered === 'ibom-way' ? (
                                      <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                                    ) : child.label}
                                  </a>
                                ))}
                            </div>
                          </div>
                        ))}
                        <div class="md:col-span-2">
                          {item.children
                            .filter((child) => child.group === 'Explore')
                            .map((child) => (
                              <a
                                href={child.href}
                                class="mt-1 flex items-center justify-between rounded-lg border border-[#d7efe9] bg-[#f0fbf8] px-4 py-3 text-sm font-bold text-[#0F766E] transition-colors hover:border-[#14B8A6] hover:bg-[#e4f8f3]"
                              >
                                <span>
                                  {child.registered === 'brando' ? (
                                    <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                                  ) : child.registered === 'ibom-framework' ? (
                                    <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                                  ) : child.registered === 'ibom-way' ? (
                                    <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                                  ) : child.label}
                                </span>
                                <span aria-hidden="true">→</span>
                              </a>
                            ))}
                        </div>
                      </div>
                    ) : (
                      <div class="grid">
                        {item.children.map((child) => (
                          <a
                            href={child.href}
                            class="rounded-lg px-5 py-4 text-sm font-semibold text-ink/88 hover:bg-[#f5f1e8] hover:text-ink transition-colors"
                          >
                            {child.registered === 'brando' ? (
                              <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                            ) : child.registered === 'ibom-framework' ? (
                              <>IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Framework</>
                            ) : child.registered === 'ibom-way' ? (
                              <>The IBOM<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup> Way</>
                            ) : child.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class="inline-flex items-center hover:text-ink transition-colors">
                {item.registered === 'brando' ? (
                  <>Brando<sup class="ml-0.5 align-super text-[0.58em] leading-none">®</sup></>
                ) : item.label}
              </a>
            )
          )}
        </nav>
        <button
          type="button"
          data-search-toggle
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="site-search-panel"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[#e7e0d4] bg-white text-ink/62 transition-colors hover:border-[#cfc4b1] hover:text-ink"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="9" r="5"></circle>
            <path d="M13 13l4 4"></path>
          </svg>
        </button>
        <div
          id="site-search-panel"
          data-search-panel
          class="absolute inset-y-[-0.2rem] right-0 flex w-full max-w-[48rem] items-center opacity-0 pointer-events-none -translate-x-8 transition-all duration-300 ease-out"
        >
          <form action="/search" method="get" class="w-full">
            <label class="sr-only" for="site-search-input">Search</label>
            <div class="relative">
              <input
                id="site-search-input"
                name="q"
                type="search"
                placeholder="Search the site..."
                class="w-full rounded-md border border-[#e7e0d4] bg-white px-4 py-3 pr-24 text-base text-ink placeholder:text-ink/35 focus:outline-none focus:ring-2 focus:ring-[#14B8A6]/30"
              />
              <button
                type="submit"
                aria-label="Submit search"
                class="absolute right-11 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-ink/52 transition-colors hover:text-ink"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="9" cy="9" r="5"></circle>
                  <path d="M13 13l4 4"></path>
                </svg>
              </button>
              <button
                type="button"
                data-search-close
                aria-label="Close search"
                class="absolute right-3 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-ink/52 transition-colors hover:text-ink"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 5l10 10"></path>
                  <path d="M15 5L5 15"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
      <a
        href={authHref}
        class="inline-flex items-center gap-2 rounded-md border border-[#d9ded8] bg-white px-5 py-2.5 text-sm font-medium text-ink/58 transition-colors hover:border-[#14B8A6] hover:text-[#0F766E] hover:bg-[#f0fbf8]"
      >
        {authLabel}
        
      </a>
      <a
        href={contactHref}
        class="inline-flex items-center gap-2 rounded-md bg-[#14B8A6] px-5 py-2.5 text-sm font-semibold text-paper hover:bg-[#0F766E] transition-colors"
      >
        Talk to Us
        
      </a>
    </div>
  </div>
  <div
    id="mobile-nav-panel"
    data-mobile-menu-panel
    class="hidden border-t border-[#e7e0d4] bg-[#fbfaf6] md:hidden"
  >
    <nav class="container-nav grid gap-1 py-4 text-base font-medium text-ink/78" aria-label="Mobile navigation">
      {nav.map((item) => (
        <>
          <a
            href={item.href}
            class="rounded-md px-3 py-3 transition-colors hover:bg-[#f1ece2] hover:text-ink"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="-mt-1 grid gap-1 border-l border-[#d7efe9] pl-4">
              {item.label === 'Products' ? (
                <p class="px-3 py-2 text-sm leading-relaxed text-ink/58">
                  Atomise your brand, build a knowledge pack, test the value, then build and deploy your agent.
                </p>
              ) : null}
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="rounded-md px-3 py-2 text-sm text-ink/64 transition-colors hover:bg-[#f1ece2] hover:text-ink"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
      <a
        href="/search"
        class="rounded-md px-3 py-3 transition-colors hover:bg-[#f1ece2] hover:text-ink"
      >
        Search
      </a>
    </nav>
  </div>
</header>
<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    const toggle = header.querySelector('[data-search-toggle]');
    const panel = header.querySelector('[data-search-panel]');
    const input = header.querySelector('#site-search-input');
    const close = header.querySelector('[data-search-close]');
    const nav = header.querySelector('[data-main-nav]');

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(panel instanceof HTMLElement)) return;
    if (!(input instanceof HTMLInputElement)) return;
    if (!(close instanceof HTMLButtonElement)) return;

    const setOpen = (open) => {
      nav?.classList.toggle('opacity-0', open);
      nav?.classList.toggle('pointer-events-none', open);
      panel.classList.toggle('opacity-0', !open);
      panel.classList.toggle('-translate-x-8', !open);
      panel.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('opacity-100', open);
      panel.classList.toggle('translate-x-0', open);
      panel.classList.toggle('pointer-events-auto', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close search' : 'Open search');
      if (open) window.requestAnimationFrame(() => input.focus());
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    close.addEventListener('click', () => setOpen(false));

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();

  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    const toggle = header.querySelector('[data-mobile-menu-toggle]');
    const panel = header.querySelector('[data-mobile-menu-panel]');
    const openIcon = header.querySelector('[data-mobile-menu-icon-open]');
    const closeIcon = header.querySelector('[data-mobile-menu-icon-close]');

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(panel instanceof HTMLElement)) return;
    if (!(openIcon instanceof SVGElement)) return;
    if (!(closeIcon instanceof SVGElement)) return;

    const setOpen = (open) => {
      panel.classList.toggle('hidden', !open);
      openIcon.classList.toggle('hidden', open);
      closeIcon.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
    });
  })();
</script>
