---
const stages = [
  { num: "01", name: "Scope", flex: "1" },
  { num: "02", name: "Define", flex: "1" },
  { num: "03", name: "Design", flex: "1" },
  {
    num: "04",
    name: "Checkpoint",
    note: "Spec, plan, and tasks validated",
    gate: true,
  },
  { num: "05", name: "Build, Test & Deploy", flex: "1.35" },
] as const;
---

<div class="ibom-visual" aria-label="IBOM checkpoint delivery visual">
  <div class="ibom-visual__markers" aria-hidden="true">
    <span>◆ Vision map · 5 working days</span>
    <span>First agents live · weeks ◆</span>
  </div>

  <div class="ibom-visual__track" aria-hidden="true">
    {stages.map((stage) =>
      stage.gate ? (
        <div class="ibom-visual__gate">
        <span class="ibom-visual__gate-top">
          <span class="ibom-visual__gate-diamond"></span>
        </span>
        <span class="ibom-visual__num ibom-visual__num--gate">{stage.num}</span>
        <span class="ibom-visual__name ibom-visual__name--gate">{stage.name}</span>
        <span class="ibom-visual__note ibom-visual__note--gate">{stage.note}</span>
        </div>
      ) : (
        <div class="ibom-visual__phase" style={`flex:${stage.flex}`}>
          <span class="ibom-visual__bar"></span>
          <span class="ibom-visual__num">{stage.num}</span>
          <span class="ibom-visual__name">{stage.name}</span>
        </div>
      )
    )}
  </div>

  <div class="ibom-visual__lanes" aria-hidden="true">
    <div class="ibom-visual__lane">
      <div class="ibom-visual__lane-bar">
        <span class="ibom-visual__lane-label">Change Enablement</span>
        <span class="ibom-visual__lane-note">from day one</span>
      </div>
    </div>
    <div class="ibom-visual__lane">
      <span class="ibom-visual__lane-spacer"></span>
      <div class="ibom-visual__lane-bar">
        <span class="ibom-visual__lane-label">Spec-driven execution</span>
        <span class="ibom-visual__lane-note">expert supervised</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ibom-visual {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(12, 18, 28, 0.08);
    border-radius: 1.35rem;
    background: #fffdf8;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: 0 18px 60px rgba(12, 18, 28, 0.06);
  }

  .ibom-visual__markers {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.95rem;
    color: #14b8a6;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ibom-visual__track {
    display: flex;
    align-items: stretch;
    min-width: 860px;
    padding: 0.35rem 0 0;
  }

  .ibom-visual__phase,
  .ibom-visual__gate {
    position: relative;
    display: flex;
    min-height: 92px;
    flex-direction: column;
    justify-content: flex-start;
    padding-right: 1.35rem;
  }

  .ibom-visual__bar {
    display: block;
    height: 9px;
    border-radius: 999px;
    background: rgba(12, 18, 28, 0.08);
    box-shadow: none;
  }

  .ibom-visual__phase:nth-child(1) .ibom-visual__bar {
    border-radius: 999px 0 0 999px;
  }

  .ibom-visual__phase:last-child .ibom-visual__bar {
    border-radius: 0 999px 999px 0;
  }

  .ibom-visual__gate {
    width: 116px;
    align-items: center;
    margin: 0 1.2rem 0 -0.2rem;
    padding-right: 0;
  }

  .ibom-visual__gate-top {
    position: relative;
    display: block;
    width: 100%;
    height: 9px;
  }

  .ibom-visual__gate-top::before,
  .ibom-visual__gate-top::after {
    position: absolute;
    top: 0;
    width: calc(50% - 20px);
    height: 9px;
    border-radius: 999px;
    background: transparent;
    content: "";
  }

  .ibom-visual__gate-top::before {
    left: 0;
  }

  .ibom-visual__gate-top::after {
    right: 0;
  }

  .ibom-visual__gate-diamond {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 0.28rem;
    background: #14b8a6;
    transform: translate(-50%, -50%) rotate(45deg);
    box-shadow: none;
  }

  .ibom-visual__num {
    margin-top: 0.9rem;
    color: rgba(12, 18, 28, 0.36);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.18em;
  }

  .ibom-visual__name {
    margin-top: 0.38rem;
    color: #0c121c;
    font-family: var(--font-display);
    font-size: clamp(0.96rem, 1.35vw, 1.14rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .ibom-visual__note {
    max-width: 9rem;
    margin-top: 0.35rem;
    color: rgba(12, 18, 28, 0.52);
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .ibom-visual__num--gate,
  .ibom-visual__name--gate {
    color: #14b8a6;
    text-align: center;
  }

  .ibom-visual__note--gate {
    color: rgba(20, 184, 166, 0.78);
  }

  .ibom-visual__lanes {
    display: grid;
    gap: 0.5rem;
    min-width: 860px;
    margin-top: 1.25rem;
  }

  .ibom-visual__lane {
    display: flex;
    align-items: center;
  }

  .ibom-visual__lane-spacer {
    flex: 0 0 62.5%;
  }

  .ibom-visual__lane-bar {
    display: flex;
    min-height: 52px;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
    background: rgba(20, 184, 166, 0.12);
    padding: 0.7rem 1.7rem 0.7rem 1.2rem;
    color: #14b8a6;
  }

  .ibom-visual__lane-label {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .ibom-visual__lane-note {
    color: #14b8a6;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .ibom-visual {
      overflow-x: auto;
    }

    .ibom-visual__markers,
    .ibom-visual__track,
    .ibom-visual__lanes {
      width: 860px;
    }
  }
</style>
