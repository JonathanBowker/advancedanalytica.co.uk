</style>

<script>
  document.querySelectorAll("[data-ibom-tabs]").forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const dataNode = root.querySelector("[data-ibom-tabs-data]");
    const queryDataNode = root.querySelector("[data-ibom-query-data]");
    const categoryDataNode = root.querySelector("[data-ibom-category-data]");
    const triggerDataNode = root.querySelector("[data-ibom-trigger-data]");
    const queryText = root.querySelector("[data-query-text]");
    const categoryLabel = root.querySelector("[data-category-label]");
    const triggerText = root.querySelector("[data-trigger-text]");
    const tabs = Array.from(root.querySelectorAll("[role='tab']"));
    const paths = Array.from(root.querySelectorAll("[data-path-index]"));
    const panel = root.querySelector("[role='tabpanel']");
    const title = root.querySelector("[data-panel-title]");
    const detail = root.querySelector("[data-panel-detail]");
    if (!(dataNode instanceof HTMLScriptElement) || !(queryDataNode instanceof HTMLScriptElement) || !(categoryDataNode instanceof HTMLScriptElement) || !(triggerDataNode instanceof HTMLScriptElement) || !(panel instanceof HTMLElement)) return;

    const items = JSON.parse(dataNode.textContent || "[]");
    const queries = JSON.parse(queryDataNode.textContent || "[]");
    const categories = JSON.parse(categoryDataNode.textContent || "[]");
    const triggers = JSON.parse(triggerDataNode.textContent || "[]");
    const pageSize = 6;
    let group = 0;
    let activeIndex = 0;
    let typingTimer = 0;
    let visibleItems = items.slice(0, pageSize);
    let hoverPaused = false;
    let mobilePaused = false;

    const isMobilePointer = () => window.matchMedia("(hover: none), (pointer: coarse)").matches;
    const isPaused = () => hoverPaused || mobilePaused;

    const shuffle = (values) => {
      const shuffled = [...values];
      for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
      }
      return shuffled;
    };

    const typeQuery = (query) => {
      if (!(queryText instanceof HTMLElement)) return;
      window.clearTimeout(typingTimer);
      queryText.textContent = "";
      const duration = 5000;
      const step = Math.max(45, duration / query.length);
      let position = 0;
      const typeNext = () => {
        if (isPaused()) {
          typingTimer = window.setTimeout(typeNext, 100);
          return;
        }
        position += 1;
        queryText.textContent = query.slice(0, position);
        if (position < query.length) typingTimer = window.setTimeout(typeNext, step);
      };
      typeNext();
    };

    const activate = (index) => {
      activeIndex = index;
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", String(active));
        tab.setAttribute("tabindex", active ? "0" : "-1");
      });
      paths.forEach((path, pathIndex) => {
        const active = pathIndex === index;
        path.classList.toggle("is-active", active);
        path.querySelectorAll(".ibom-tabs__flow-motion").forEach((motion) => {
          motion.setAttribute("dur", active ? "1.15s" : "2.8s");
        });
      });
      panel.setAttribute("aria-labelledby", `ibom-tab-${index}`);
      const item = visibleItems[index];
      if (title) title.textContent = item.title;
      if (detail) detail.textContent = item.detail;
    };

    const showGroup = (nextGroup) => {
      group = nextGroup;
      visibleItems = shuffle(items.slice(group * pageSize, (group + 1) * pageSize));
      if (categoryLabel) categoryLabel.textContent = categories[group];
      if (triggerText) triggerText.textContent = triggers[group];
      tabs.forEach((tab, index) => {
        const item = visibleItems[index];
        const tabTitle = tab.querySelector("[data-tab-title]");
        const tabDescription = tab.querySelector("[data-tab-description]");
        const tabBadge = tab.querySelector("[data-tab-badge]");
        if (tabTitle) tabTitle.textContent = item.title;
        if (tabDescription) tabDescription.textContent = item.description;
        if (tabBadge) {
          tabBadge.textContent = item.badge || "";
          tabBadge.classList.toggle("is-visible", Boolean(item.badge));
        }
      });
      activate(activeIndex);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index));
      tab.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (!["ArrowDown", "ArrowUp", "ArrowRight", "ArrowLeft"].includes(event.key)) return;
        event.preventDefault();
        const direction = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
        const next = (index + direction + tabs.length) % tabs.length;
        activate(next);
        if (tabs[next] instanceof HTMLElement) tabs[next].focus();
      });
    });

    const pauseTargets = Array.from(
      root.querySelectorAll(".ibom-tabs__tab, .ibom-tabs__output-card")
    );

    pauseTargets.forEach((target) => {
      target.addEventListener("mouseenter", () => {
        hoverPaused = true;
      });
      target.addEventListener("mouseleave", () => {
        hoverPaused = false;
      });
      target.addEventListener("click", () => {
        if (isMobilePointer()) mobilePaused = true;
      });
    });

    root.addEventListener("click", (event) => {
      if (!isMobilePointer() || !(event.target instanceof Element)) return;
      if (!event.target.closest(".ibom-tabs__tab, .ibom-tabs__output-card")) {
        mobilePaused = false;
      }
    });

    showGroup(0);
    typeQuery(queries[0]);
    let cyclePosition = 0;
    window.setInterval(() => {
      if (isPaused()) return;
      cyclePosition += 1;
      if (cyclePosition < pageSize) {
        let nextIndex = activeIndex;
        while (nextIndex === activeIndex) {
          nextIndex = Math.floor(Math.random() * pageSize);
        }
        activate(nextIndex);
        return;
      }

      cyclePosition = 0;
      activeIndex = 0;
      const nextGroup = (group + 1) % queries.length;
      showGroup(nextGroup);
      typeQuery(queries[nextGroup]);
    }, 1000);
  });
</script>
